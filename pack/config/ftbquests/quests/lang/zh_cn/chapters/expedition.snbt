{
	quest.C626FE1864C2E065.title: "情报墙"
	quest.C626FE1864C2E065.description: [
	"一面墙把已知的国家、据点、风险全标出来——地图、坐标、名字。"
	"⚠️ 「标全了没有」判不了（覆盖率是主观的），这一条自检。"
	]
	quest.BBEE977DE690D5AD.title: "远征队登记"
	quest.BBEE977DE690D5AD.description: [
	"出发前写清：谁去、去哪、带什么、什么时候回来。"
	"这一条不是仪式——出事时它是唯一能让留守的人知道去哪找你们的记录。"
	"⚠️ 名册的**内容**判不了，自检。"
	]
	quest.6BFE189A86F5780A.title: "第一次远征归来"
	quest.6BFE189A86F5780A.description: [
	"1000 格外走一趟再全员回来。指挥棒不是判据——「走出去」才是。"
	]
	quest.14ECC39709D0E6DE.title: "路上有补给"
	quest.14ECC39709D0E6DE.description: [
	"远行链路上至少 2 个能补给的站点（驿站、仓储点、传送节点都行）。"
	]
	quest.FA354929A2C8AE1E.title: "远征装备间"
	quest.FA354929A2C8AE1E.description: [
	"出发前领装备的地方：食物、工具、床、船各一处，拿了就走。"
	]
	quest.5D89C94B4EB06036.title: "档案馆"
	quest.5D89C94B4EB06036.description: [
	"把带回来的书、地图、唱片集中收在一处——不然它们会散在每个人背包里。"
	]
	quest.18AEA59555CFBB5E.title: "第一次下界远征"
	quest.18AEA59555CFBB5E.description: [
	"跨维度是远征的第一次质变：补给、坐标、退路全都要重新算。"
	"这条游戏会自己判定（进入下界）。"
	]
	quest.5D18C2C5A96839A5.title: "世界地图"
	quest.5D18C2C5A96839A5.description: [
	"把 5000 格范围连成图。到这一步，你们才有资格谈「天下」。"
	]
	quest.07D4103743410B08.title: "三种结构"
	quest.07D4103743410B08.description: [
	"三种不同来源的结构各探一处，并在地图上留标记。"
	"结构 mod 多、进度少（实测结构类 mod 基本不发 advancement），所以判据落在「到过」上。"
	]
	quest.0B2C8385D4050199.title: "海上远航"
	quest.0B2C8385D4050199.description: [
	"用船走一段真正的海路（沉船、海底遗迹都在这一层）。"
	]
	quest.1DFCD8AEADA9D90F.title: "登高"
	quest.1DFCD8AEADA9D90F.description: [
	"爬到 Y≥200 的地形上——站在高处看，才知道自己走了多远。"
	]
	quest.E795CA68FAFF6F1E.title: "穿越沙漠"
	quest.E795CA68FAFF6F1E.description: [
	"横穿一次沙漠，带回至少 2 种那儿的特产。"
	]
	quest.429CC4982149AF91.title: "灯塔"
	quest.429CC4982149AF91.description: [
	"夜里从远处能看见的一处光源——它让远方有方向。"
	]
	quest.FE4CB4620AE3F55D.title: "前哨"
	quest.FE4CB4620AE3F55D.description: [
	"远征链路上有一座能挡袭击的小据点：墙、门、床、补给。"
	]
	quest.5C5C18A0F6293419.title: "开始追踪"
	quest.5C5C18A0F6293419.description: [
	"这个时代解锁情报站第三档的升级件（`eras.json` 的 `intel_station_2`）。"
	"升级后能追踪国家、看谁在打谁、每结算深挖一国详报。"
	"⚠️ 升级动作本身判不了（模组不发进度），自检。"
	]
	quest.FAF2D6F95D0D6573.title: "远征碑"
	quest.FAF2D6F95D0D6573.description: [
	"刻上走过多远、去过哪些地方。"
	"下一时代是压力时代：把远征带回来的东西变成工事。"
	]
	quest.97BF458B10BE19F4.title: "谁去、谁留守"
	quest.97BF458B10BE19F4.description: [
	"出发前把队伍劈成两半：外出的人按「能互相救」编组，留守的人要够用来看住家。"
	"**留守名单和远征名单一样重要** —— 只写在墙上的名单，出事时没人看。"
	]
	quest.C8A1A75F7A4C793D.title: "装备清单"
	quest.C8A1A75F7A4C793D.description: [
	"全队照同一张清单装包：镐、剑、食物、水、床、火把、备用工具各一份。"
	"清单的意义是**不必临出发再想**，也避免有人只带了镐子就出门。"
	]
	quest.CA05040435A35BA8.title: "联络约定"
	quest.CA05040435A35BA8.description: [
	"三条最省事的约定：多久没消息算异常、失联时先找哪、在哪个坐标集合。"
	"⚠️ 约定本身判不了。但它要**写下来贴在议事厅**，不能只在口头上。"
	]
	quest.C05D13ABC26ABCE9.title: "定点报平安"
	quest.C05D13ABC26ABCE9.description: [
	"每到一处补给点做一次点名：人在不在、谁受伤、剩多少补给。"
	"点名是搜救的前提 —— 没有点名记录，出事时连「什么时候丢的」都不知道。"
	]
	quest.6626A296A8B350D3.title: "追一只回来的方向"
	quest.6626A296A8B350D3.description: [
	"每人一个回程方向的凭据：重生罗盘、磁石、指南针都行 —— 关键是**不靠地图也能回**。"
	"地图会在死亡掉落、会在水里糊掉；方向感不会。"
	]
	quest.875AAA3C128EEE4E.title: "站点间距"
	quest.875AAA3C128EEE4E.description: [
	"补给点按**一天的路程**布置，不是按地图好看的程度布置。"
	"先量一次：从主城到第一个站点走多久。超过一天，中间必须再加一个。"
	]
	quest.424281F0E5FF3B91.title: "三处驿站"
	quest.424281F0E5FF3B91.description: [
	"同一方向上排三处：第一处是出发日的目的地，第三处是这次远征的边界。"
	"三处连起来，这条路才叫「有后勤的路」。"
	]
	quest.5057BFEC824353E7.title: "每个驿站备什么"
	quest.5057BFEC824353E7.description: [
	"一箱食物、一桶水、一组火把、一张床、一把备用镐 —— 每处驿站都照这个配。"
	"配得一样的好处是：**到哪一处都能马上补给**，不用先找东西。"
	]
	quest.A2C99631D8D8772D.title: "驿站要认得出来"
	quest.A2C99631D8D8772D.description: [
	"每一处驿站必须**从远处就能认**：一杆旗、一盏长明灯、或者一座塔。"
	"找站点花的时间不能超过赶路的时间 —— 否则这条路是负资产。"
	]
	quest.F6D6ABEDD55D3461.title: "补给网成型"
	quest.F6D6ABEDD55D3461.description: [
	"两个方向各三处站点，彼此能互相支援 —— 这时远征半径才不再受背包限制。"
	"这是「出关」这一章真正的门槛：**有网才敢走远**。"
	]
	quest.BDFCC48FEE9B74FF.title: "用自然罗盘找群系"
	quest.BDFCC48FEE9B74FF.description: [
	"要什么木头、什么动物、什么作物，先问自然罗盘 —— 它直接给最近的那个群系。"
	"**先定群系再定路线**，比走到哪算哪省一半时间。"
	]
	quest.904CCACD8B65EE27.title: "用结构罗盘找遗迹"
	quest.904CCACD8B65EE27.description: [
	"结构罗盘给最近的结构坐标：要找哪种遗迹，就点那种。"
	"这是本章最实用的一件工具 —— 它把「碰运气」换成了「有计划」。"
	]
	quest.A129479BBF9A2C29.title: "罗盘要能修"
	quest.A129479BBF9A2C29.description: [
	"两个罗盘都是消耗品（用一次损一点），备件与修复材料要常备。"
	"出远门前先确认：罗盘还能用几次。"
	]
	quest.ED5DE534E24FF5D9.title: "世界地图记路线"
	quest.ED5DE534E24FF5D9.description: [
	"（这些是纯客户端 mod，注册表里没有它们的命名空间、也没有任何物品 ——"
	"所以判据落在实物上：图上要有的那张地图本身，与沿途钉下的路径点。）"
	]
	quest.77C2DBDC15E34DBF.title: "沿途钉锚点"
	quest.77C2DBDC15E34DBF.description: [
	"每处值得再来的地方放一块磁石或一个路标：**下次不必重新找**。"
	"锚点的价值会随次数增长 —— 第一次是标记，第五次是网络。"
	]
	quest.91D3CB5FE80130B7.title: "队内定位"
	quest.91D3CB5FE80130B7.description: [
	"队员之间互相定位的罗盘：**散开搜遗迹时用它集合**。"
	"多人远征最容易出的事不是打不过，是找不到人。"
	]
	quest.31171798ACD3B902.title: "导航这块成型"
	quest.31171798ACD3B902.description: [
	"找群系、找结构、记路线、钉锚点、队内定位 —— 五件齐了，远征才算「组织」而不是「出走」。"
	]
	quest.3ADB040DC01B7E33.title: "造船"
	quest.3ADB040DC01B7E33.description: [
	"Small Ships：风帆船能装货、能载多人 —— 海运的吞吐是划艇的几倍。"
	"海洋方向的远征从此不必贴着岸走。"
	]
	quest.2B77214A112324B6.title: "武装帆船"
	quest.2B77214A112324B6.description: [
	"带炮位的船：远海要防的不只是浪，还有别人。"
	"（船炮本身在「战斗与军械」章会再提一次 —— 那里讲打，这里讲走。）"
	]
	quest.10D7528DB240B26A.title: "货船"
	quest.10D7528DB240B26A.description: [
	"把「运回来」这件事做成一趟能搬空的量：箱子船比背包船重要得多。"
	]
	quest.476EC15DEA876A64.title: "铺一段铁路"
	quest.476EC15DEA876A64.description: [
	"从主城往远征方向铺一段轨 —— 铁路的运量比任何背包都大。"
	"铁轨铺到哪里，「后方」就延伸到哪里。"
	]
	quest.54DD099086C04007.title: "终点站"
	quest.54DD099086C04007.description: [
	"一段路要有个尽头：站点方块 + 信号机，让列车知道该停哪。"
	]
	quest.D29076B291F46A70.title: "排出时刻表"
	quest.D29076B291F46A70.description: [
	"列车不用人开：时刻表 + 站台，跑起来就是一条自动补给线。"
	"到这一步，**补给从「人扛」变成「按点发车」**。"
	]
	quest.EFFCCC6C96C88B87.title: "道口要有人管"
	quest.EFFCCC6C96C88B87.description: [
	"铁路穿过大路的地方要闸门与延长杆 —— 铁路上撞一次，整条线的料都得重来。"
	]
	quest.249DA9F44D428674.title: "列车长"
	quest.249DA9F44D428674.description: [
	"指挥哨 + 列车长帽：站台上吹一声，人和货都动起来。"
	]
	quest.8FC9040C652BCDEE.title: "垂直运输"
	quest.8FC9040C652BCDEE.description: [
	"矿道、塔楼、前哨的上下全靠它：电梯彩色区分，一眼知道哪台去哪层。"
	"远征里最费时间的动作是「上下爬」，不是「走远路」。"
	]
	quest.A74898C8002DDAB6.title: "跨维度回程"
	quest.A74898C8002DDAB6.description: [
	"下界、末地走一趟，**回来比去难**：传送门卷轴与绑定卷轴要提前备好。"
	"（传送网络的权限与共享是「领地与队伍」章的事，这里只管带在身上那几张。）"
	]
	quest.A45C2C9A56889A25.title: "海陆轨三线都通"
	quest.A45C2C9A56889A25.description: [
	"船走海、车走轨、脚走陆 —— 三条线各有各的活。到这一步，"
	"「多远算远」这个问题才第一次有了答案。"
	]
	quest.95D975D4DAD40DF3.title: "洞穴勘察"
	quest.95D975D4DAD40DF3.description: [
	"洞穴远征要带三样别的：绳子（脚手架）、备用光源、一条**能退回来**的记号线。"
	"洞穴里的死因几乎全是迷路，不是打不过。"
	]
	quest.6037782C1C817741.title: "洞穴带回来的"
	quest.6037782C1C817741.description: [
	"判定标准不是「走了多深」，是**带回了多少能用在地面上的东西**：矿、发光植物、苔藓。"
	]
	quest.56004CDC23980B1F.title: "沼泽远征"
	quest.56004CDC23980B1F.description: [
	"沼泽是**建材与药材的产地**：黏土、睡莲、蘑菇、红树林木。"
	"路难走，所以这趟要一次带够，别来回三趟。"
	]
	quest.750FDC18C87F3892.title: "丛林远征"
	quest.750FDC18C87F3892.description: [
	"丛林给竹子、可可豆、西瓜与丛林木 —— 高度落差大，落下去就上不来。"
	"带够脚手架，丛林其实是最划算的一趟。"
	]
	quest.573DEC378286B780.title: "雪原远征"
	quest.573DEC378286B780.description: [
	"雪原的主要风险不是怪，是**细雪与失温**：普通雪球下去就出不来。"
	"带皮革靴与细雪桶，别穿铁靴进去。"
	]
	quest.5F0BF491E13EC1C9.title: "深海远征"
	quest.5F0BF491E13EC1C9.description: [
	"海底遗迹与沉船都在深处：水下呼吸、夜视、以及一条**回水面的路**。"
	"海晶灯与海晶碎片是这一趟最实用的收获。"
	]
	quest.AEB161DD867A1375.title: "下界纵深"
	quest.AEB161DD867A1375.description: [
	"下界远征要按「一进一出」算：进去多少格、出来多少格、路上有没有锚点。"
	"烈焰棒与下界合金碎片的产地都在深处 —— 这是**唯一**能拿到它们的地方。"
	]
	quest.6B412C2B677BFD17.title: "末地远征"
	quest.6B412C2B677BFD17.description: [
	"末地是**一次性远征**：准备错了没法回头补。"
	"全队一起去，末影之眼与回程手段先备齐 —— 这是一趟不能有人掉队的行程。"
	]
	quest.FD033BD9E3C55852.title: "考古学桌"
	quest.FD033BD9E3C55852.description: [
	"Better Archeology：把「可疑的沙土」变成实物的那一张桌子。"
	"遗迹考察从此不再只是「找箱子」，而是**挖一处的完整流程**。"
	]
	quest.2E59E0045AF81F2D.title: "刷子要升级"
	quest.2E59E0045AF81F2D.description: [
	"铁刷、钻石刷、下界合金刷：**刷得越快，一趟能挖的遗迹越多**。"
	"钻石刷是这一章的性价比拐点。"
	]
	quest.34677B55E08BDE7F.title: "砸古代花瓶"
	quest.34677B55E08BDE7F.description: [
	"遗迹里的花瓶砸开有货 —— 这是最直接的一条「遗迹产出」。"
	]
	quest.AF924459B8DAFF74.title: "拼出第一具化石"
	quest.AF924459B8DAFF74.description: [
	"化石分头骨与身体两半，凑齐才算一具。头骨能当展示品，**身体有实际用途**。"
	"这一条游戏会自己判定（发现化石）。"
	]
	quest.E288EFDFCE92034E.title: "六具化石齐了"
	quest.E288EFDFCE92034E.description: [
	"六种化石全部拼完 —— 这是一条**长线收集**：每一具都要刷很多处遗迹。"
	"它们的陈列室就是「结构与遗迹」章里博物馆的前身。"
	]
	quest.68113D78757C4A01.title: "鉴定神器"
	quest.68113D78757C4A01.description: [
	"未鉴定的神器要鉴定后才成型：神器碎片是这条链的原料。"
	]
	quest.DB64EA4A0E69EE43.title: "带一具图腾回来"
	quest.DB64EA4A0E69EE43.description: [
	"考古图腾各有用途：生长、光辉、灵魂、洪流 —— 它们是**遗迹里唯一能带回城的实用件**。"
	]
	quest.2FF954C8EABBC759.title: "遗迹考察成体系"
	quest.2FF954C8EABBC759.description: [
	"桌子、刷子、化石、神器、图腾 —— 一趟遗迹能从「找箱子」升级成一条产线。"
	"到这一步，远征的产出才配得上它的成本。"
	]
	quest.1BF95DD9E2946639.title: "远征报告"
	quest.1BF95DD9E2946639.description: [
	"回来之后交一页：去了哪、走了多少格、带回了什么、下次还去不去。"
	"报告是**下一趟的起点** —— 没有它，每次远征都从零开始。"
	]
	quest.F2A6F42FF3F688B0.title: "把地图补上"
	quest.F2A6F42FF3F688B0.description: [
	"报告写完就更新情报墙：新群系、新站点、新风险，当次就标。"
	"**当场标比事后回忆准得多。**"
	]
	quest.5C6DA452A1DDA0E7.title: "战利品怎么分"
	quest.5C6DA452A1DDA0E7.description: [
	"带回来的东西先入库再分，别在门口就地分了 —— 就地分的结局是**没人记账**。"
	"（公共仓库与账本是「立国」与「国库」章的事；这里只定「先入库」这一条纪律。）"
	]
	quest.F4AF62A5B2D9CD7F.title: "紧急撤离路线"
	quest.F4AF62A5B2D9CD7F.description: [
	"每一趟出发前定好**往回跑的那条线**：往哪跑、在哪集合、谁断后。"
	"路线要在出发前走一遍 —— 事到临头再找路，等于没有路。"
	]
	quest.0BF4D26487972E33.title: "搜救队"
	quest.0BF4D26487972E33.description: [
	"失联之后谁来救、带什么、找多久：**搜救队要提前指定**，不能临时喊人。"
	"搜救装备与远征装备不同：光源、床、食物、以及不恋战的纪律。"
	]
	quest.30AA387D8F851AD3.title: "伤亡要记账"
	quest.30AA387D8F851AD3.description: [
	"死了谁、在哪、为什么 —— 记进档案馆。这条记录会直接改变下一次的编组。"
	"（碑林与史册章会把「记名」做成制度；这里先记在远征报告里。）"
	]
	quest.CE1EF4A599DA3CD8.title: "前哨加墙"
	quest.CE1EF4A599DA3CD8.description: [
	"前哨从「能睡一觉」升级到「能守一夜」：石砖墙 + 一道门 + 一条退路。"
	]
	quest.261DD04960B33823.title: "据点的仓储"
	quest.261DD04960B33823.description: [
	"据点要有**自己的一份库存**：不必每次从主城带全套过去。"
	"有余粮的据点才能当中转站用。"
	]
	quest.4FD91D1564825983.title: "据点防刷怪"
	quest.4FD91D1564825983.description: [
	"据点的敌人不是来攻城的，是**刷在墙里**的：巨型火把或恐惧之灯把范围清干净。"
	"一个据点如果夜夜有人死，它就不是据点，是陷阱。"
	]
	quest.221D5C7EC41721E5.title: "据点接入传送网"
	quest.221D5C7EC41721E5.description: [
	"据点与主城之间连一座传送石：**来回一次从一天变成一瞬间**。"
	"（传送权限与共享是「领地与队伍」章的事；这里只要求这座据点上网。）"
	]
	quest.BD3C817D6BA8FBFE.title: "据点常驻"
	quest.BD3C817D6BA8FBFE.description: [
	"据点要有人常驻才算据点，否则它只是一间没人住的房子。"
	"常驻的标准：床、粮、值夜排班 —— 三样都有。"
	]
	quest.1096B8C2496DDB11.title: "边界外插旗"
	quest.1096B8C2496DDB11.description: [
	"走出去立一面旗：**旗是「我们到过这里」的凭据**，也是下一次的坐标。"
	"旗立在补给点或据点旁，不要插在路中间。"
	]
	quest.247C06AA6B5CD3B0.title: "未探索区标记"
	quest.247C06AA6B5CD3B0.description: [
	"情报墙上要有一块**明确的空白**：标出「还没去过」的区域，而不是留白让人以为去过了。"
	"知道哪里没去过，比知道哪里去过更值钱。"
	]
	quest.7B5FFB0D392E679C.title: "把建筑扫成图纸"
	quest.7B5FFB0D392E679C.description: [
	"Portable Blueprints：扫描仪把见到的建筑存成图纸，**带回来就能复建**。"
	"这是远征产出里唯一能直接变成「城里的东西」的一类。"
	]
	quest.D8BF2FB53273A3EB.title: "边界推到哪，国就到哪"
	quest.D8BF2FB53273A3EB.description: [
	"旗、锚点、据点、图纸四样齐了：边界以外第一次有了**可复现的东西**。"
	"下一时代是压力时代：把远征带回来的东西变成工事。"
	]
}
