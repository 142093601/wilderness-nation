{
	quest.29C3777502434B67.title: "从手摇开始"
	quest.29C3777502434B67.description: [
	"这一章不讲机器怎么用——Create 自带 Ponder 动画（对着方块按 W 就能看）。"
	"这里只回答「先做哪台、为什么」。第一步：手摇曲柄 + 一个传动件，让它转起来。"
	]
	quest.7451A54DB59888A1.title: "扳手"
	quest.7451A54DB59888A1.description: [
	"整包最该先做的一件东西。它不只是工具：旋转方块、拆下方块、改机器朝向、"
	"设置漏斗与管道的过滤，全靠它。没有它，后面每一步都要绕路。"
	]
	quest.02C5CE038C85A341.title: "工程师护目镜"
	quest.02C5CE038C85A341.description: [
	"戴上它才能「看见」应力：哪个机器超载、整条线还剩多少余量。"
	"机械动力里最常见的故障是应力打满，而护目镜是唯一能直接看出这件事的手段。"
	]
	quest.36E73CFBDF0010C6.title: "第一台水车"
	quest.36E73CFBDF0010C6.description: [
	"手摇只能应急。水车是最便宜的自持动力源：只要旁边有流水，它就一直转。"
	"选址要求不高，适合做第一条真正能连续运转的产线。"
	]
	quest.6F4F20AAE29056C3.title: "大水车"
	quest.6F4F20AAE29056C3.description: [
	"同面积下转速更低、应力更高。要拖大机器、又不想铺一长排小水车时用它。"
	]
	quest.C78C2A20100EE7A3.title: "风车"
	quest.C78C2A20100EE7A3.description: [
	"水车受地形限制，风车不受：装在高处就能出动力。代价是占地大、叶片要多。"
	"它是从「靠地形」走向「自己造动力」的中间一步。"
	]
	quest.96620325FA426F7E.title: "把风车拉满"
	quest.96620325FA426F7E.description: [
	"满叶片的风车能顶好几台水车。做到这一步，前期动力基本不用再操心。"
	]
	quest.947061E00EAC8526.title: "传动杆"
	quest.947061E00EAC8526.description: [
	"动力的「电线」。所有旋转都要靠它从一个地方送到另一个地方。"
	"先囤一把：后面每加一台机器都要用。"
	]
	quest.761293C4D949AC6A.title: "小齿轮"
	quest.761293C4D949AC6A.description: [
	"两个齿轮咬在一起 = 换向 + 换速。它是传动链里最基本的连接件。"
	]
	quest.4D39C53B6D3CD260.title: "大齿轮"
	quest.4D39C53B6D3CD260.description: [
	"大带小时转速升高、应力降低；小带大相反。"
	"需要「转得更快」的机器（比如锯）就得靠它。"
	]
	quest.151145F51B9CE9E3.title: "十字齿轮箱"
	quest.151145F51B9CE9E3.description: [
	"在一个方块里完成换向，省掉一排齿轮。空间紧张时首选。"
	]
	quest.90FF43AF06BBEFAA.title: "竖直齿轮箱"
	quest.90FF43AF06BBEFAA.description: [
	"把动力从水平转到垂直。往楼上送动力、做垂直流水线时用。"
	]
	quest.E46A9AA733149A18.title: "离合器"
	quest.E46A9AA733149A18.description: [
	"红石信号一到就切断动力。这是「按需启停」的第一步——"
	"让机器不用一直转，省应力也省磨损。"
	]
	quest.CD5A65578861A58E.title: "反转齿轮箱"
	quest.CD5A65578861A58E.description: [
	"红石控制正反转。凡是「来回运动」的装置（门、闸、升降）都要它。"
	]
	quest.EE59F45154FA8E39.title: "链式传动箱"
	quest.EE59F45154FA8E39.description: [
	"隔空传动力，不用铺一长排传动杆。两处距离远、中间又不想占地方时用它。"
	]
	quest.8BC26EB267F0EB46.title: "转速控制器"
	quest.8BC26EB267F0EB46.description: [
	"集中调一条线的转速。生产速度要按需调整时，比到处换齿轮方便得多。"
	]
	quest.754D0FB80083F56C.title: "应力计"
	quest.754D0FB80083F56C.description: [
	"护目镜看的是「你自己」，应力计看的是「这一条网络」。"
	"产线一大就需要它来定位是哪一段吃满了应力。"
	]
	quest.07E8F9B0D732A0B5.title: "安山合金"
	quest.07E8F9B0D732A0B5.description: [
	"整套机械的动力材料都从这里开始。安山岩 + 铁粒/锌粒，成本低、用量大。"
	]
	quest.677562020BC633CC.title: "安山机壳"
	quest.677562020BC633CC.description: [
	"大多数基础机器的外壳。剥皮原木 + 安山合金，做一批放着。"
	]
	quest.2CD0A344F01555D5.title: "石磨"
	quest.2CD0A344F01555D5.description: [
	"不用手推的第一台加工机器。磨面粉、磨一些基础材料都靠它。"
	]
	quest.1FD98DE649FA479A.title: "粉碎轮"
	quest.1FD98DE649FA479A.description: [
	"一对轮子把原料磨成更细的东西，矿石、建材都从这里过一道。"
	"它是整条产线的第一道工序，也是后面所有配方的入口。"
	]
	quest.DC6F8DB5A4AD05CB.title: "压与拌"
	quest.DC6F8DB5A4AD05CB.description: [
	"机械压床 + 机械搅拌器：这是后面所有合成的前置。"
	"压床把锭变成板，搅拌器在动力盆里混合——两者缺一不可。"
	]
	quest.C8B9B2426391CAFA.title: "动力盆"
	quest.C8B9B2426391CAFA.description: [
	"混合、压制、酿造都在盆里进行。搅拌器必须配它才有产出。"
	]
	quest.2DCF52E95177E40D.title: "烈焰人燃烧室"
	quest.2DCF52E95177E40D.description: [
	"需要「加热」的配方都要它，而加热强度直接决定产能。"
	"喂烈焰蛋糕才能到最高档——这是后面蒸汽机的关键前置。"
	]
	quest.FA1C138757AB1512.title: "动力锯"
	quest.FA1C138757AB1512.description: [
	"有了动力，先让机器替你切木头。省下的是重复劳动。"
	]
	quest.0D6C775D42BF872C.title: "动力钻头"
	quest.0D6C775D42BF872C.description: [
	"自动挖前方的方块。装在动态结构上就是一台移动挖掘机。"
	]
	quest.9F2454C188185917.title: "风处理"
	quest.9F2454C188185917.description: [
	"鼓风机：批量洗涤、烟熏、冶炼——一台机器顶三条线。"
	"前面放熔岩、火或水，同一台机器就有三种完全不同的用途。"
	]
	quest.34DD6F871B314F59.title: "注液器"
	quest.34DD6F871B314F59.description: [
	"往物品里灌流体：装桶、灌药水、做食物都在这里。这是流体线的出口。"
	]
	quest.237CFF0E5B694802.title: "机械手"
	quest.237CFF0E5B694802.description: [
	"模拟「玩家右键」这个动作：使用工具、给铜打蜡、剪羊毛、点按钮。"
	"很多东西只有机械手能自动化。"
	]
	quest.E800BCFF9C817607.title: "第一条传送带"
	quest.E800BCFF9C817607.description: [
	"东西自己从 A 走到 B 的那一刻，这个包才算真正开始「自动化」。"
	"传送带负责运，漏斗负责取放——它们是一对。"
	]
	quest.E3BF4B91D280A07E.title: "溜槽"
	quest.E3BF4B91D280A07E.description: [
	"垂直搬运的廉价方案：从上层直接落到下层，不耗动力。"
	]
	quest.03595200C6C0524A.title: "置物台"
	quest.03595200C6C0524A.description: [
	"让机器有地方「对着」加工。压床、机械手、注液器都需要它当工作台。"
	]
	quest.5834C6F1099E640A.title: "黄铜漏斗"
	quest.5834C6F1099E640A.description: [
	"带过滤的漏斗：只让指定的东西进或出。"
	"分类和「只喂对的料」全靠它，是物流从能用变成好用的分界。"
	]
	quest.0E7095532B2EF630.title: "智能溜槽"
	quest.0E7095532B2EF630.description: [
	"带过滤的溜槽。垂直线上也要分类时用它。"
	]
	quest.0417A0113DAACA31.title: "物品保险库"
	quest.0417A0113DAACA31.description: [
	"比箱子能装、还能相邻合并成一个大仓。"
	"公共仓库的地基——放成 2x2 或 3x3 就是一个大容量库房。"
	]
	quest.973BB284BC8B716E.title: "仓储与打包"
	quest.973BB284BC8B716E.description: [
	"仓储管理员 + 打包机：让仓库自己管进出。"
	"这一条做完，公共仓库才算「能支撑全队」。"
	]
	quest.1EB674E484E3A57B.title: "库存清单"
	quest.1EB674E484E3A57B.description: [
	"把仓库里有什么、剩多少显示出来。多人共仓时，这是唯一不用问人的办法。"
	]
	quest.EF034081DA00292F.title: "蛙口包站"
	quest.EF034081DA00292F.description: [
	"包裹的收发口。一条传送带 + 两个包站，就把两个仓库连起来了。"
	]
	quest.A80A8C826943ADD9.title: "流体管道"
	quest.A80A8C826943ADD9.description: [
	"流体的「电线」。先铺管道，才有后面整套液体产线。"
	]
	quest.44B495FE80C0F15F.title: "动力泵"
	quest.44B495FE80C0F15F.description: [
	"管道自己不会流，要泵来推。转速决定流量。"
	]
	quest.D853A7A5FD048EDF.title: "流体储罐"
	quest.D853A7A5FD048EDF.description: [
	"存液体，也当缓冲。相邻放置能合并容量——做大库存时靠这个。"
	]
	quest.9DE62F484BE77E9D.title: "智能流体管道"
	quest.9DE62F484BE77E9D.description: [
	"带过滤的流体管道。只让一种液体通过，是流体分类的关键件。"
	]
	quest.1780548656838B11.title: "软管卷筒"
	quest.1780548656838B11.description: [
	"从水池、岩浆湖就地抽液体，不用人工搬桶。"
	"把「找水源」这件事从劳动变成基建。"
	]
	quest.332CF44211BA55C8.title: "黄铜时代"
	quest.332CF44211BA55C8.description: [
	"黄铜是精密件（机械臂、过滤器、控制器）的门槛。"
	"先把黄铜锭与黄铜机壳各做一份出来——后面每一台高阶机器都要它们。"
	]
	quest.79D023D4CDBD2C41.title: "精密构件"
	quest.79D023D4CDBD2C41.description: [
	"构件本身不直接用在建筑上，它是高阶机器的原料。"
	"能做它，说明你的动力与产能已经撑得住后面那些大件了。"
	]
	quest.8354069EBDB1BF05.title: "机械臂"
	quest.8354069EBDB1BF05.description: [
	"前面几步都要人守着。机械臂替你取放物品，箱子与机器之间才算真的连起来。"
	"它是第一条不需要人站在旁边的产线——从这里开始可以谈「自动化」了。"
	]
	quest.2EC8CFCBCB725B43.title: "无线红石"
	quest.2EC8CFCBCB725B43.description: [
	"隔空传红石信号，不用拉一长条线。跨建筑控制时省事得多。"
	]
	quest.18A97A6C661C268F.title: "锁存器"
	quest.18A97A6C661C268F.description: [
	"把「按一下」变成「保持打开/关闭」。自动化里最常见的状态需求。"
	]
	quest.DAA3AA3B36403650.title: "脉冲延长器"
	quest.DAA3AA3B36403650.description: [
	"短信号变长信号。很多机器需要持续几秒的红石才动作。"
	]
	quest.7E6A4A1A8A388F92.title: "可编程齿轮箱"
	quest.7E6A4A1A8A388F92.description: [
	"按步骤执行一连串旋转动作，每步的角度与速度都能写。"
	"凡是「按顺序动几下」的机构，用它一次就能省掉一堆红石。"
	]
	quest.2AB1D1132EB23C0F.title: "工厂仪表"
	quest.2AB1D1132EB23C0F.description: [
	"看一条线现在在做什么、卡在哪。产线一多，没有它就只能靠猜。"
	]
	quest.A0FB052CBF6027C3.title: "强力胶"
	quest.A0FB052CBF6027C3.description: [
	"把方块粘成一个整体，好让它们一起动。所有会动的机械都从这一步开始。"
	]
	quest.99833ECD2D9BCC74.title: "动力轴承"
	quest.99833ECD2D9BCC74.description: [
	"让一整块结构旋转——风车的核心，也是旋转门、旋转平台的实现方式。"
	]
	quest.C77439DF567204C2.title: "绳索滑轮"
	quest.C77439DF567204C2.description: [
	"升降平台与吊桥。楼层之间搬人搬货，比铺楼梯省地方。"
	]
	quest.07D866CA958AEA88.title: "动力活塞"
	quest.07D866CA958AEA88.description: [
	"把结构整体推出去或拉回来。可移动的桥、伸缩的门都用它。"
	]
	quest.DDA854055D9E1AC8.title: "起重机"
	quest.DDA854055D9E1AC8.description: [
	"沿轨道平移一整块结构。大型吊装和跨区间搬运靠它。"
	]
	quest.87BCCCCEE42E61E9.title: "动态结构控制器"
	quest.87BCCCCEE42E61E9.description: [
	"站上去就能开动你造的那台机器。这是「能开的东西」和「能造的东西」的分界。"
	]
	quest.7AA4A3DF13B5F9FD.title: "粘性方块"
	quest.7AA4A3DF13B5F9FD.description: [
	"抓取并搬动单个方块或实体——机械臂够不到的地方用它。"
	]
	quest.98D95ADAA686F89C.title: "蒸汽机"
	quest.98D95ADAA686F89C.description: [
	"从「靠自然」到「自己烧出一整片动力」——这是量变到质变的那一步。"
	"搭一台蒸汽机并让它转起来：燃料自己加，动力不再看天。"
	]
	quest.5F33E6138C5A7CC3.title: "汽笛"
	quest.5F33E6138C5A7CC3.description: [
	"纯粹的仪式感——但它也是「这台机器在正常工作」最直观的信号。"
	]
	quest.09674DD8DF6FD1A4.title: "铜制背罐"
	quest.09674DD8DF6FD1A4.description: [
	"背着走的压缩空气罐，让手持工具也能用动力。"
	"从「机器在工厂里」到「工具跟着人走」。"
	]
	quest.2624A5F76F42113A.title: "铁路"
	quest.2624A5F76F42113A.description: [
	"两个地点之间点对点运输。设计里「交通等级扩大远征半径」就靠它。"
	]
	quest.77172BA579D4519F.title: "车站"
	quest.77172BA579D4519F.description: [
	"列车停靠与装卸的地点。有站才有「线路」，不然只是一段轨道。"
	]
	quest.629E755062250FD0.title: "信号灯"
	quest.629E755062250FD0.description: [
	"多列车共用一段轨道时防止相撞。线路一复杂就必须有它。"
	]
	quest.06751382970747BC.title: "列车长"
	quest.06751382970747BC.description: [
	"让列车按时刻表自动跑，不用人开。"
	"这一条成立，运输才算「基建」而不是「劳动」。"
	]
	quest.D186347AA23CC267.title: "编组列车"
	quest.D186347AA23CC267.description: [
	"一次拉更多货。单趟运力上去，铁路才值得铺到远处。"
	]
	quest.16B756E5BA16C508.title: "列车过传送门"
	quest.16B756E5BA16C508.description: [
	"让铁路跨维度。这是铁路能服务「远征」时代的前提。"
	]
	quest.09F3400D28695148.title: "全自动的一天"
	quest.09F3400D28695148.description: [
	"让至少三件事完全不用人管：原料进去、成品出来，中间没有人。"
	"这一条是「基建」时代的彩排——它成立，基建时代才有东西可做。"
	]
	quest.5871145E8164334B.title: "机械合成器"
	quest.5871145E8164334B.description: [
	"一个会自己合成的格子。九个排在一起才等于一张工作台。"
	"有了它，箱子里的材料才可能自己变成成品。"
	]
	quest.AD5D0C99F3D80521.title: "合成阵列"
	quest.AD5D0C99F3D80521.description: [
	"九个机械合成器排成 3x3 —— 用**置物台或溜槽**喂料，别用手塞。"
	]
	quest.36999F7504AC7D1C.title: "装配线"
	quest.36999F7504AC7D1C.description: [
	"Create 最核心的一件事：**让传送带带着半成品依次经过每一道工序**。"
	"一条典型的线是：压 → 锯 → 注液 → 机械手 → 出成品。"
	"（节拍与吞吐在「机械动力·物流」那一章，这一条只要求你真的排出一条。）"
	]
	quest.89A7039B5C990C7E.title: "装配线上出精密构件"
	quest.89A7039B5C990C7E.description: [
	"手搓也能出精密构件，但那样就白搭这条线了。"
	"用自己排的线做出四个，才算这条线真的通了。"
	]
	quest.043CE24D1AE50AAC.title: "动态结构上的物品口"
	quest.043CE24D1AE50AAC.description: [
	"移动的机器（钻头臂、收割机）怎么把东西交回固定产线？靠这个口。"
	]
	quest.834F9236A928E28E.title: "流体阀门"
	quest.834F9236A928E28E.description: [
	"流体也要能在工序之间开关，否则注液那一段永远在漏。"
	]
	quest.D6484E0D46FE7243.title: "动力犁"
	quest.D6484E0D46FE7243.description: [
	"把一块地整片翻好：农业自动化的第一步。"
	]
	quest.1B0CD30EBF245FE8.title: "动力收割机"
	quest.1B0CD30EBF245FE8.description: [
	"和犁配套：一个开地，一个收成。装在移动机械上就是一整台农机。"
	]
	quest.5FD5C0AEBF051951.title: "农机组"
	quest.5FD5C0AEBF051951.description: [
	"把犁、收割机、储物箱装到**同一个移动机械**上，让它在地里走一趟全干完。"
	"这是这个包里第一台真正自己干活的机器。"
	]
	quest.4684573A4BF12468.title: "电梯"
	quest.4684573A4BF12468.description: [
	"上下运输不必修楼梯：一个滑轮加一块平台，就是一栋楼的电梯。"
	]
	quest.3DD7FB84F8D165F2.title: "发条轴承"
	quest.3DD7FB84F8D165F2.description: [
	"让一整个结构绕自己的轴转 —— 风车叶、瞭望台、旋转餐厅都靠它。"
	]
	quest.13A7626A03B1022A.title: "压路机"
	quest.13A7626A03B1022A.description: [
	"铺路、压平、压实。城市级道路工程靠它省下大量手工。"
	]
	quest.D952411AF255CC7E.title: "移动仓储接口"
	quest.D952411AF255CC7E.description: [
	"让在动的机器和**固定的仓库**直接交换物品 —— 移动产线的关键一件。"
	]
	quest.6BB29155492367DE.title: "移动流体接口"
	quest.A078785ECB17FCC5.title: "内容观测器"
	quest.A078785ECB17FCC5.description: [
	"它看的不是有没有方块，是**容器里有没有东西**。"
	"自动化里最常用的一类条件：满了停、空了启。"
	]
	quest.B4252ED0B2F3902A.title: "模拟拉杆"
	quest.B4252ED0B2F3902A.description: [
	"能给 0~15 任意档位的拉杆：调速、定量的场合靠它。"
	]
	quest.D8E6DB07B013EE86.title: "展示板"
	quest.D8E6DB07B013EE86.description: [
	"贴在产线旁边的一块信息板：显示库存、转速、开关状态。"
	"**让机器自己报状态**，比每次跑过去看一眼强得多。"
	]
	quest.B042C4003795BB9E.title: "数码管"
	quest.B042C4003795BB9E.description: [
	"把数值显示出来。产线出问题时，数字对不对是最快的判断依据。"
	]
	quest.491BAA5845C645D5.title: "轨道观测器"
	quest.D0B19F76791D8CC6.title: "布谷鸟钟"
	quest.D0B19F76791D8CC6.description: [
	"会报时的装饰件。公共空间里放一个，比钟表更像个地方。"
	]
	quest.BE8137B0E999459D.title: "延长抓取器"
	quest.BE8137B0E999459D.description: [
	"够得着更远的地方 —— 装机器、拆机器时省掉一半跑动。"
	]
	quest.45A6E2343D2E77AE.title: "列车时刻表"
	quest.45A6E2343D2E77AE.description: [
	"让列车按表走：哪里停、停多久、装什么货。"
	"（线路本身在「蒸汽与铁路」那一章，这里只讲排班这件事。）"
	]
	quest.7ECE7C79802A18B7.title: "合成蓝图"
	quest.7ECE7C79802A18B7.description: [
	"把常用配方抄一份挂在工位上 —— 新人不必问人就能照做。"
	]
	quest.D565E464EE181BE8.title: "采购清单"
	quest.D565E464EE181BE8.description: [
	"盖大工程时最费时间的不是搬，是**忘了还缺什么**。"
	]
	quest.273E869E8B31076E.title: "蓝图炮"
	quest.273E869E8B31076E.description: [
	"把一张图纸**直接盖出来** —— 这是从手工建筑跨到工程化建造的那一步。"
	"（图纸怎么扫描、怎么修、怎么组织施工在「图纸与工程」那一章；这里只要用一次。）"
	]
}
