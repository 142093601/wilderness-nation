{
	quest.5071E4F2CB18E4A8.title: "设立营地"
	quest.5071E4F2CB18E4A8.description: [
	"找一块同时满足四件事的地方：水源、可耕地、能防守、附近有旧世痕迹。"
	"选址是集体决定，游戏里没有「大家同意了」这个信号，所以这一条自己打勾。"
	"别跳过它——后面每个时代的碑都立在这块地上。"
	]
	quest.92BC7ECEF767E31F.title: "第一间避难所"
	quest.92BC7ECEF767E31F.description: [
	"有床、有门、有屋顶。躺下睡一觉——游戏会记下「你在这里过夜了」。"
	]
	quest.D275E7F6C6B265F9.title: "火与食"
	quest.D275E7F6C6B265F9.description: [
	"把熔炉点起来，炼出第一块铁。这一条游戏会自己确认。"
	]
	quest.B1F7E6B9350025F1.title: "活着过第一晚"
	quest.B1F7E6B9350025F1.description: [
	"游戏不记录「天亮时你到底在不在附近」，所以这一条没有可靠判据。"
	"天亮了、人还在、东西没丢，就自己打个勾。过不去，说明上面哪一条偷工减料了。"
	]
	quest.E1D40D49617EAFEA.title: "把水固定下来"
	quest.E1D40D49617EAFEA.description: [
	"别每次跑半张地图打水。用水桶把炼药锅灌满，就算是有了自己的水源。"
	]
	quest.319539F5405B3D60.title: "把营地围起来"
	quest.319539F5405B3D60.description: [
	"栅栏围一圈，至少要有个能关上的入口。"
	"「围起来了」这件事游戏里判不了（原版没有「放置方块」统计）。"
	]
	quest.3F1D32F62F8F6602.title: "把家圈成领地"
	quest.3F1D32F62F8F6602.description: [
	"用认领工具把营地圈下来——这是「我们的地」第一次在游戏里成立。"
	"之后别人的破坏、放置、开箱都会被拦。"
	"⚠️ 圈地的判据要等 mod 侧提供可检测信号（见 NEEDS-YOU / 交接说明），现在自检。"
	]
	quest.552AE9AC00FE1F61.title: "走出生点 500 格"
	quest.552AE9AC00FE1F61.description: [
	"带上食物和水，往任意方向走满 500 格再回来。游戏会按步数自己算。"
	"重点不是走多远，是沿路记住：水在哪、地形怎么走、有没有旧世的痕迹。"
	]
	quest.79D9FD4E9FEDCCAD.title: "一把说得过去的剑"
	quest.79D9FD4E9FEDCCAD.description: [
	"石器只能应急。铁制工具做出来，采集与战斗才算真正开始。"
	"从这一步起，你们才有余力想「留下点什么」——落成碑要等到它能立得稳。"
	]
	quest.2A31C1DDBB640C1F.title: "落成碑"
	quest.2A31C1DDBB640C1F.description: [
	"用石砖在营地立一块碑，刻上「元年 · 落地」和你们选址的理由。"
	"这块碑是后面所有时代的坐标起点——以后会有人回来看它。"
	]
	quest.33F284A1D42989F8.title: "画一张营地草图"
	quest.33F284A1D42989F8.description: [
	"落地第一步不是盖房子，是**把这块地看清楚**。"
	"一张地图加一路标记：哪边是水、哪边是林子、哪边会淹、哪边能通行。"
	"这张草图决定后面所有分区怎么摆 —— 摆错了，改起来的代价是拆房。"
	]
	quest.3BAB702165362371.title: "地势要看清"
	quest.3BAB702165362371.description: [
	"营地要同时有平地与坡地：平地盖房种田，坡地排水、防守、瞭望。"
	"记下最低点在哪 —— 下雨和灌溉都要靠这个判断。"
	]
	quest.1A79F2B8E7F03212.title: "先确认水够不够"
	quest.1A79F2B8E7F03212.description: [
	"一处不够：至少两处独立水源（河、湖、泉各算一处），旱季与堵塞都不至于断水。"
	"水源离营地超过两百格，选址就该重新考虑。"
	]
	quest.A27AABFA9F2C0FEF.title: "近处要有林子"
	quest.A27AABFA9F2C0FEF.description: [
	"木料是最先耗尽的东西：盖房、烧炭、做工具全要它。"
	"把最近的一片林子标下来，并且**只从这里取木**，别四面乱砍。"
	]
	quest.FEAD911C5D298D61.title: "浅层矿口"
	quest.FEAD911C5D298D61.description: [
	"落地阶段只要两种矿：煤与铁。它们在浅层就够了，不必往下深挖。"
	"找到就记坐标 —— 第一个矿井的位置由它决定。"
	]
	quest.ACB8D51C468C0852.title: "邻国有多远"
	quest.ACB8D51C468C0852.description: [
	"这块地上不只你们：最近的村庄、据点、甚至别人的营地都在算距离之内。"
	"记下方位与距离，落地决议里要写清「和他们是什么关系」。"
	]
	quest.A4F10A1DEBCB1DD5.title: "把选址理由记下来"
	quest.A4F10A1DEBCB1DD5.description: [
	"写成一页成书，至少三行：为什么是这里、放弃过哪里、这块地缺什么。"
	"⚠️ 书里**写了什么**游戏判不了（written_book 只证明「有一本成书」），"
	"所以这一条在实物判据之外补一个 checkmark：确认理由是**真的写下来**的。"
	"这一页后面会在落成碑上重写一遍 —— 现在写的是草稿，也是唯一的证据。"
	]
	quest.8DE6B03425A4EF02.title: "第一口井"
	quest.8DE6B03425A4EF02.description: [
	"井不只是取水点，它是**营地的中心**：所有分区从此按「离井多远」来摆。"
	"石砖围一圈，加炼药锅与栅栏盖，免得有人掉进去。"
	]
	quest.F92FF5A82758BD5E.title: "蓄水缸"
	quest.F92FF5A82758BD5E.description: [
	"井会被占、河会走远：一排炼药锅就是营地的短期储备。"
	"灭火、洗涤、配药都从这里取，不必每次跑井边。"
	]
	quest.2061C328D56495DB.title: "垃圾与排污点"
	quest.2061C328D56495DB.description: [
	"落地阶段第一个真正的「公共问题」不是粮食，是**往哪儿扔东西**。"
	"定一个固定的坑：岩浆处理可燃与腐坏物，远处一格专门堆建材废料。"
	"有了这个点，「营地里到处是随手丢的箱子」这件事才会停。"
	]
	quest.BB1F9EAC86B2D62F.title: "沤肥坑"
	quest.BB1F9EAC86B2D62F.description: [
	"厨余、落叶、烂作物都有去处：堆肥桶产骨粉，骨粉催苗。"
	"排污点不必只是「扔掉」，它可以是第一块田的肥料来源。"
	]
	quest.237356BB1462546D.title: "储物棚"
	quest.237356BB1462546D.description: [
	"把散落各人背包里的东西集中到一间棚：箱子排开，通道留够，能走进去找。"
	"这一间棚是后面「公共仓库」的雏形 —— 先有地方，再谈规矩。"
	]
	quest.777E1794572600F7.title: "工作棚"
	quest.777E1794572600F7.description: [
	"工作台、熔炉、箱子分开放：合成、烧炼、存货三条动线互不挡路。"
	"合成区要留出**站着不打架**的宽度 —— 多人同时用工作台是常态。"
	]
	quest.1DA6F9F435E396FA.title: "每间棚挂一块牌"
	quest.1DA6F9F435E396FA.description: [
	"落地期的秩序全靠牌子：哪间放什么、哪格归谁，写在门口。"
	"牌子不解决管理问题，但它让**新来的人不必问人**。"
	]
	quest.7AD0C6A45311B9E0.title: "围栏与门"
	quest.7AD0C6A45311B9E0.description: [
	"围栏要围出**一条完整的线**，并且只有一到两个入口 —— 入口越多，夜里的防线越薄。"
	"木栅栏够用；石墙留给后面「御敌」章。"
	]
	quest.6169E1D0B61A0A40.title: "入口能关上"
	quest.6169E1D0B61A0A40.description: [
	"每个入口配一套可开合的闸：木栅栏门、铁门、活板门都行，关键是**能关**。"
	"关不上的入口等于没有围栏。"
	]
	quest.2E1EA62008261EC1.title: "夜里看得见路"
	quest.2E1EA62008261EC1.description: [
	"灯不是装饰：围栏内侧走一圈全点亮，巡逻的人才知道自己走到哪一格。"
	"用灯笼而不是火把 —— 灯笼挂得住、淋不灭，围墙上更好摆。"
	]
	quest.5ACDC53FEE7F879B.title: "先备一批煤"
	quest.5ACDC53FEE7F879B.description: [
	"燃料是这个阶段**唯一不可替代的消耗品**：熔炉、火把、篝火全靠它。"
	"落地期就要按「一组煤 = 一天」来估，别等熔炉停了才去挖。"
	]
	quest.05BE9CD0546BB005.title: "烧炭备用"
	quest.05BE9CD0546BB005.description: [
	"煤脉会挖空，木炭不会：只要还有林子，火就不会断。"
	"这是落地期的**燃料保险**，也是后面烧砖烧玻璃的底料。"
	]
	quest.48503FDCEBABAE5B.title: "燃料单独一间"
	quest.48503FDCEBABAE5B.description: [
	"燃料与建材分开存：混着放的后果是「烧着烧着发现把要用的木头烧了」。"
	"单独立一间或单独立一排桶，数量一眼能数。"
	]
	quest.B95987381577B088.title: "木料堆场"
	quest.B95987381577B088.description: [
	"原木、木板、木棍分区码放，并且**离熔炉远一点**。"
	"堆场是后面所有工程的第一道料场，位置定错了会一直被绕路。"
	]
	quest.6A9F6A24CC96D651.title: "第一块田"
	quest.6A9F6A24CC96D651.description: [
	"全队的口粮不能只靠打猎。挑离井最近的一块地，全部格都要有水。"
	"田的位置一旦定下来，后面灌溉与仓储都会围着它长。"
	]
	quest.17CDD43AFA9CFEEE.title: "田里自己带水"
	quest.17CDD43AFA9CFEEE.description: [
	"一格水源能润四格耕地：把水渠摆对，就不必每天提桶浇。"
	"这是落地期最便宜的一次「自动化」——一次摆对，永久省事。"
	]
	quest.70C9CDB04C66DF29.title: "先把种子留出来"
	quest.70C9CDB04C66DF29.description: [
	"好吃的东西要留种：小麦、胡萝卜、马铃薯各留一批不入口。"
	"种粮比收粮重要 —— 断种就等于从头来过。"
	]
	quest.187F72A27AB91638.title: "第一批畜栏"
	quest.187F72A27AB91638.description: [
	"用小麦把牛羊引回来：两只起步（能繁殖），围栏单独隔一间。"
	"畜栏与田要分开 —— 混在一块会把耕地踩掉。"
	]
	quest.67BEA26050CB8A25.title: "饲料与口粮分开"
	quest.67BEA26050CB8A25.description: [
	"喂牲口的麦子与给人吃的口粮必须是两笔账 —— 混着放，灾年就得杀牲口。"
	"干草块是最省地方的饲料形态。"
	]
	quest.D5C11D1FB3DA10E0.title: "每人一张床"
	quest.D5C11D1FB3DA10E0.description: [
	"床把重生点固定在营地里 —— 这是「落地」两个字最实际的含义。"
	"床位不够时先把床补齐，再谈盖房：先能活，再住得好。"
	]
	quest.094CDDA2A84CEDEA.title: "生活区圈出来"
	quest.094CDDA2A84CEDEA.description: [
	"卧室集中在一处，离工作棚远一点：夜里熔炉还在响，睡不踏实。"
	"生活区与作业区分开之后，营地第一次有了「街」的概念。"
	]
	quest.D4ACF1C99D87450E.title: "出工也带睡袋"
	quest.8DF418E0909B79BE.title: "营地锚点"
	quest.8DF418E0909B79BE.description: [
	"一块磁石加一个重生点标记：从外面回来时，不必先找地图就知道家在哪个方向。"
	"落地期的「回家」还只是方向问题；到出关章，它会变成补给与通讯问题。"
	]
	quest.A5BEDB0FF4026F05.title: "给营地起个名"
	quest.A5BEDB0FF4026F05.description: [
	"没名字的地方不能叫「家」，只能叫「附近」。"
	"名字要能刻在牌上、写进书里、挂在旗上 —— 取之前先想清楚它好不好念。"
	"⚠️ 名字本身游戏判不了，但牌子与旗是实物判据。"
	]
	quest.003B9F463727586F.title: "入口挂牌"
	quest.003B9F463727586F.description: [
	"营地入口一块牌：名字、落成年月、谁立的。"
	"这是全包第一块「公共文字」—— 立国章那块公示牌是它的正式版。"
	]
	quest.112AFBFE5462CE37.title: "营地的钟"
	quest.112AFBFE5462CE37.description: [
	"站在这块地上敲一下，所有人知道该回哪儿。"
	"它同时是「这块地已经有人管」最省事的信号 —— 不必等旗杆立起来。"
	]
	quest.F3892DC7459CFE98.title: "去水源的路"
	quest.F3892DC7459CFE98.description: [
	"营地到井/河之间铺一条**能推车**的路：碎石或木板均可，关键是宽度一致、不绕路。"
	"这条路以后会被当作全城路网的基线，别随手铺。"
	]
	quest.9AF7C3C7E3A516EF.title: "去林场的路"
	quest.9AF7C3C7E3A516EF.description: [
	"第二条路通往木料来源。两条路不要在营地正中交叉 —— 交汇点会变成事实上的广场。"
	"路上每隔一段放一盏灯，天黑也能走。"
	]
	quest.8CE1BF53AB470F58.title: "预留扩建区"
	quest.8CE1BF53AB470F58.description: [
	"**故意空出一块地**不盖东西：以后的仓库、议事厅、纪念碑都要地方。"
	"落地期最贵的错误是把好地皮用棚子填满 —— 后面每一间房都得拆。"
	]
	quest.A79CC3CE770E5FFD.title: "先把四角标出来"
	quest.A79CC3CE770E5FFD.description: [
	"在预留区的四个角各放一根柱子或一块石砖，标出这块地**已经有人认领**。"
	"这是立国章「四至与界碑」的草稿：正式界碑要有编号，这里只要一根柱子。"
	]
	quest.05244AD8AFD01A26.title: "落成仪式的料"
	quest.05244AD8AFD01A26.description: [
	"碑、旗、灯三样先备齐：石碑刻字、旗帜挂名、灯笼通宵点着。"
	"这些东西本身不难做，难的是**在搬进去之前就把它们准备好**。"
	]
	quest.D4ACF1C99D87450E.description: [
	"外出砍柴、探路、跑远活时带一张睡袋：就地睡一觉，不必赶回营地。"
	"它不替换营地的床，只是把「回不回得去」这件事的压力降下来。"
	]
}
