{
	quest.E81134A89EA7314A.title: "圈下国土"
	quest.E81134A89EA7314A.description: [
	"用认领工具把营地扩成国土——至少 9 个区块（3×3），别只圈一间房。"
	"OPAC 这类模组**没有物品接口**（实测：lang 里 item 键为 0），所以圈没圈成只能自己确认。"
	"验证方式：让一个不在队里的人试着挖一块——挖不动才算数。"
	]
	quest.475F1C6F43EF5CD3.title: "所有人进同一个队"
	quest.475F1C6F43EF5CD3.description: [
	"两条路（FTB Teams 或 OPAC party），**只选一条**，别两套并行。"
	"同一类问题：队伍也没有物品判据。判据是你自己确认「所有人都能在领地里动东西」。"
	]
	quest.DB7BA37A2FFB5A0F.title: "公共仓库开张"
	quest.DB7BA37A2FFB5A0F.description: [
	"不再靠背包搬运：把物资集中到一处，谁都能取。"
	"Create 的物品保险库是这一层的正解（一个保险库顶几十个箱子）。"
	]
	quest.7DC50BAF62C2C391.title: "仓库要装得下全队"
	quest.7DC50BAF62C2C391.description: [
	"一个保险库只是起步。攒到 16 个，才算「公共仓库」而不是「大一点的箱子」。"
	]
	quest.3CBEB252F888F42C.title: "定下约定"
	quest.3CBEB252F888F42C.description: [
	"把规矩写下来放进议事厅（告示牌或成书）——至少一条要说清「违反了会怎样」。"
	"⚠️ 书的**内容**游戏判不了（放书架能检测，但「约定了」不能）。所以这一条自检。"
	"别写成墙上装饰：写一条真的会被执行的。"
	]
	quest.E0F5966B20480B11.title: "第一座地标：议事厅"
	quest.E0F5966B20480B11.description: [
	"由多人共同建成的一处公共建筑——它是这个国家第一个「不属于任何个人」的地方。"
	]
	quest.8238A7F85CAEF8B1.title: "议事厅坐得下所有人"
	quest.8238A7F85CAEF8B1.description: [
	"能坐下说话才算议事厅：至少 8 个座位。"
	]
	quest.51A59E062FC474DC.title: "粮仓起步"
	quest.51A59E062FC474DC.description: [
	"一箱小麦 + 一箱胡萝卜或马铃薯。饿肚子守不住国。"
	]
	quest.FB501FB48EDC8C67.title: "圈一块农田"
	quest.FB501FB48EDC8C67.description: [
	"≥16 格耕地，全部有水源。种下去（游戏会记「你种过种子」）。"
	]
	quest.91A33DCE8F4D55D4.title: "牧场起步"
	quest.91A33DCE8F4D55D4.description: [
	"≥4 只同种动物圈在栏里。繁殖过一次就算成型。"
	]
	quest.0A88AE552BD9041D.title: "上路"
	quest.0A88AE552BD9041D.description: [
	"一条能走的路，连到最近的水源或林地。"
	]
	quest.69D31E3C68A93F41.title: "夜里不黑"
	quest.69D31E3C68A93F41.description: [
	"主路两侧点起来。黑的地方就是它们来的地方。"
	]
	quest.3284B6D76DEF7328.title: "石料自给"
	quest.3284B6D76DEF7328.description: [
	"一台持续产圆石的机器，替代手挖。这是第一条「不用人管」的线。"
	]
	quest.E9C0C90E535D93B8.title: "批量烧炼"
	quest.E9C0C90E535D93B8.description: [
	"一次投料连续工作，不用守着加燃料。"
	]
	quest.23EB81CB0E119992.title: "立国碑"
	quest.23EB81CB0E119992.description: [
	"刻上国号，立在议事厅前。"
	"这一条是「基建」时代的彩排：碑立好了，接下来该往外修了。"
	]
	quest.7D4701541F4F8151.title: "定国号"
	quest.7D4701541F4F8151.description: [
	"国号是一个要写在碑上、挂在旗上、刻在界碑上的东西 —— **定下来就别改**。"
	"规则很简单：两个字能念完、能缩写、不会和邻国重名。"
	"⚠️ 名字本身游戏判不了，自检；但下一段「立国公示」那条会把名字真的落到实物上。"
	]
	quest.9DA735F84A439A45.title: "国旗"
	quest.9DA735F84A439A45.description: [
	"旗的颜色是有含义的：三种色就够，多了从远处看不清。"
	"旗要先在议事厅挂一面，再复制到每个入口与界碑旁 —— **同一面旗出现三次，它才算国家的**。"
	]
	quest.F8DFABDA2A53D2A9.title: "给旗加图案"
	quest.F8DFABDA2A53D2A9.description: [
	"纯色旗和别人的分不开。一个图案纹样就够：它是这面旗的「签名」。"
	]
	quest.FFCF3EEDDE53430D.title: "旗挂在议事厅正面"
	quest.FFCF3EEDDE53430D.description: [
	"旗杆立在议事厅门口，**朝着国门的方向**。"
	"它同时兼一个功能：从外面回来的人，远远看见旗就知道到家了。"
	]
	quest.7C5F0E741C8161B8.title: "量一遍四至"
	quest.7C5F0E741C8161B8.description: [
	"国土的四个方向各走到头，记下坐标：这就是「四至」，写进成书存进议事厅。"
	"四至不必是矩形 —— 但**必须能一句话说清边界在哪**，否则守不住也管不了。"
	]
	quest.D6F514F5CC4914D7.title: "立界碑"
	quest.D6F514F5CC4914D7.description: [
	"四角各一块刻字石头：正面国号，背面坐标与朝向。"
	"界碑是**给外人看的**：不认字的人也知道这里有人管。"
	]
	quest.A611209E08A9E33A.title: "界碑编号"
	quest.A611209E08A9E33A.description: [
	"界碑一多就会乱：用雕凿工具或木牌给每块编号，编号与四至那本书对得上。"
	"没有编号的界碑，几年后没人说得清哪块是哪块。"
	]
	quest.21146772260947AB.title: "沿边界的路标"
	quest.21146772260947AB.description: [
	"边界不只有四角：每隔一段插一根柱子或火把，走夜路时边界是看得见的。"
	]
	quest.C93565F202F9AD45.title: "权限分三档"
	quest.C93565F202F9AD45.description: [
	"**全员同权限等于没有权限**。要分的档：能管（动边界与成员）、能建（动方块）、能住（只进出门与用设施）。"
	"这一条只定「分几档、每档能干什么」；具体怎么在 OPAC 里配置是另一章的事。"
	]
	quest.6B0A90EAB80ADDE9.title: "把每档的名单写出来"
	quest.6B0A90EAB80ADDE9.description: [
	"牌子上写清：谁在哪一档、为什么。名单要贴在议事厅，不能只存在队长的记忆里。"
	]
	quest.96BCB6D2203122E5.title: "访客怎么办"
	quest.96BCB6D2203122E5.description: [
	"邻国的人、路过的人、还没入伙的人：他们能不能进城、能到哪、能不能开箱。"
	"**先定访客规则，再谈外交** —— 不然第一次来人就是一次事故。"
	]
	quest.8D3FA3FAB32C4895.title: "权限这块闭环了"
	quest.8D3FA3FAB32C4895.description: [
	"分档、名单、访客规则三样齐了，「我们的地」才算有一套能执行的说法。"
	"从这一条起，国土的边界不再靠人盯着。"
	]
	quest.FFAF720D1BA45977.title: "国册：谁是谁"
	quest.FFAF720D1BA45977.description: [
	"一页纸写清全体成员与入伙时间 —— 这是「我们」第一次有正式名单。"
	]
	quest.EF8A51D7FD7E5653.title: "编组"
	quest.EF8A51D7FD7E5653.description: [
	"超过五个人就该分组：建设组、后勤组、远征组 —— 每组一个负责人。"
	"分组的目的是**让缺席的人不影响别人干活**，不是为了排等级。"
	]
	quest.F16E4C9C07F1CC3B.title: "议事规则"
	quest.F16E4C9C07F1CC3B.description: [
	"写清三件事：多久开一次、怎么表决、谁记录。"
	"⚠️ 规则文本游戏判不了，自检。少的不是仪式，是**出事时知道找谁拍板**。"
	]
	quest.7AA8D88A40910D0C.title: "会议记录本"
	quest.7AA8D88A40910D0C.description: [
	"每次议完留一页：定了什么、谁反对、下次检查什么。"
	"记录本比记忆可靠 —— 它也是后面「交接与继承」唯一的凭据。"
	]
	quest.18C842AF47188C16.title: "第一次表决"
	quest.18C842AF47188C16.description: [
	"拿一件真事来练：下一座公共建筑盖在哪、叫什么。"
	"表决的价值不在于结果对不对，在于**输了的人愿不愿意照做**。"
	]
	quest.C7FBBF780F833264.title: "岗位表"
	quest.C7FBBF780F833264.description: [
	"把「这个国家需要哪些活」列成一张表：建设、采集、冶炼、仓储、远征、防务。"
	"表上要留空位 —— 空位就是**招人的理由**。"
	]
	quest.1A21B61F79782321.title: "岗位挂牌"
	quest.1A21B61F79782321.description: [
	"每个岗位一块牌，挂在它对应的棚门口：这里负责什么、找谁。"
	"（这一条**不写居民职业** —— 那是「人口与民生」章的事。）"
	]
	quest.1256CD27556B32AA.title: "值夜安排"
	quest.1256CD27556B32AA.description: [
	"谁在夜里看着：一次排一周，固定在牌上。"
	"值夜这件事没有实物判据，但**钟与床是它的实物** —— 有钟、有床、有排班表，才算排过班。"
	]
	quest.DB6950773452C9D9.title: "换班要交接"
	quest.DB6950773452C9D9.description: [
	"值夜换班时对一次：东西少了没有、有没有人来过、哪块墙破了。"
	]
	quest.2F593F64F092E6B2.title: "国徽"
	quest.2F593F64F092E6B2.description: [
	"国旗是给人远看的，国徽是给人近看的：一个图案，刻在议事厅地板上或挂在正门上方。"
	"它要能**被复制** —— 每个公共建筑门口都该有一块。"
	]
	quest.B7965576C4570E72.title: "定一首国歌"
	quest.B7965576C4570E72.description: [
	"国歌不是写出来的，是**选出来的**：从已有的唱片里挑一首，全体认它。"
	"选好之后固定下来：升旗、开会、落成仪式都放它。"
	]
	quest.A21723CDAF3B9001.title: "国歌唱片入档"
	quest.A21723CDAF3B9001.description: [
	"那张唱片要存一份在议事厅，别让它跟着某个人出门。"
	"档案就是「这个国家有什么」的清单 —— 唱片是它的第一件。"
	]
	quest.F0C5CA966C890C91.title: "开一次升旗会"
	quest.F0C5CA966C890C91.description: [
	"国旗、国徽、国歌三样齐了，就把它们**一起用一次**：升旗、奏歌、点灯。"
	"仪式本身不产出任何资源，它产出的是「我们是一个国家」这句话的可信度。"
	]
	quest.417863C63B0077B8.title: "给邻国定性"
	quest.417863C63B0077B8.description: [
	"把已知的邻国/据点逐个定性：通商、同盟、中立、敌对。一国一句，写进成书。"
	"⚠️ 定性是主观判断，游戏判不了，自检。但**必须先有定性**，邦交章才有起点。"
	]
	quest.0F8CC1ADE03A9EF8.title: "给邻国留一面旗"
	quest.0F8CC1ADE03A9EF8.description: [
	"送一面自己的旗过去（或者留一面对方的旗在议事厅）：**关系要有实物凭据**。"
	"这一条也是邦交章「国书」的草稿 —— 那边会把它做成正式流程。"
	]
	quest.F0A80CD8813EAF4C.title: "第一个五年计划"
	quest.F0A80CD8813EAF4C.description: [
	"按这个包的五个时代各写一条目标（二十小时一格）：每个时代结束时，国家应该多出什么。"
	"写的是**结果**不是任务清单：「有一座桥」比「修一条路」好，因为前者能验收。"
	]
	quest.2489312B7BC4BAAF.title: "计划挂在墙上"
	quest.2489312B7BC4BAAF.description: [
	"计划写进书里只有一个人看，挂在议事厅才有全部人看。"
	"配一面地图墙：计划里的每一项目标，都在图上有位置。"
	]
	quest.DD0681D02EE64CE9.title: "定国庆日"
	quest.DD0681D02EE64CE9.description: [
	"把「立国碑竖起来的那一天」定成国庆日，写进国册与公示牌。"
	"每年这一天做同一件事：读一遍国册、检查一遍四至、看一眼五年计划。"
	]
	quest.6175C978F602397D.title: "立国公示"
	quest.6175C978F602397D.description: [
	"在议事厅门口立一块公共告示：国号、成立日期、四至、当前成员数。"
	"这是**这个国家的门面**：新来的人、路过的人，先看它。"
	]
	quest.1237C4A6BDF8A768.title: "国册成书"
	quest.1237C4A6BDF8A768.description: [
	"把四件事抄进同一本成书：国号与旗、四至与界碑编号、权限三档、议事规则。"
	"这本册子要**能被抄写** —— 副本存在议事厅，正本跟着当值的人。"
	]
	quest.98C7A9BFE0954EB0.title: "新成员加入流程"
	quest.98C7A9BFE0954EB0.description: [
	"四步写清：谁引荐、谁批准、给什么（住处与工具）、先干什么。"
	"没有流程，新人前几天就只能在城里乱转 —— 这是**最容易流失人的一段时间**。"
	]
	quest.FA133B9084F8C71F.title: "交接与继承规则"
	quest.FA133B9084F8C71F.description: [
	"写清两件事：当值的人长期不在时谁接手、国册与钥匙交给谁。"
	"⚠️ 判不了，自检。**这是全章最容易被跳过、也最容易出事的一条。**"
	"验收方式：假装当值的人明天不来了，念一遍规则 —— 念不下去就是没写清。"
	]
}
