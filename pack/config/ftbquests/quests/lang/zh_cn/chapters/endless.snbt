{
	quest.FCA46EFC0F5C2834.title: "每个纪元加一块碑"
	quest.FCA46EFC0F5C2834.description: [
	"结算到新纪元就立一块——碑林越长，越舍不得走（这是设计里明确的留人手段）。"
	"⚠️ 立碑动作没有信号源，自检。"
	]
	quest.37B1E9FB849570E1.title: "图鉴与收藏"
	quest.37B1E9FB849570E1.description: [
	"横向目标第一类：把「见过但没留」的东西补回来。"
	"先做一轮全群系踏查——原版进度会给这个盖章。"
	]
	quest.071B2979D10983F0.title: "吃遍世界"
	quest.071B2979D10983F0.description: [
	"设计里「图鉴」最实在的一种：把所有能吃的东西吃一遍。"
	"原版有这个进度（均衡饮食），而这个包的食物多得多。"
	]
	quest.E1F8A2C6645C5875.title: "屠尽怪物图鉴"
	quest.E1F8A2C6645C5875.description: [
	"杀过每一种怪。这是最难也最像「毕业考」的一条。"
	]
	quest.68895283165294D7.title: "建筑目录"
	quest.68895283165294D7.description: [
	"横向目标第二类：把标准件与地标做成一份「目录」，谁都能照着复现。"
	"图纸是这一层的载体（便携图纸 / 图案图纸都是实物）。"
	]
	quest.BEEA6E30D46B2FAF.title: "把图纸链用顺手"
	quest.BEEA6E30D46B2FAF.description: [
	"扫一座建筑 → 存成图纸 → 别人照着放。这一条打通之后，造城速度会变一个量级。"
	]
	quest.2D147B443E2296C1.title: "图案图纸"
	quest.2D147B443E2296C1.description: [
	"Create 系的图案图纸：适合小构件与重复纹样。"
	]
	quest.399025CD07715437.title: "国史完本"
	quest.399025CD07715437.description: [
	"横向目标第三类：把国史从「写到一半」补成完本——每个时代、每场战争、每个亡国。"
	]
	quest.1F8821E6FD699235.title: "无尽工程 · 其一"
	quest.1F8821E6FD699235.description: [
	"选一件「没有任何人要求你们做」的工程，然后做完它。"
	"这一条之后没有下一块碑了——想做什么都由你们自己定。"
	]
}
