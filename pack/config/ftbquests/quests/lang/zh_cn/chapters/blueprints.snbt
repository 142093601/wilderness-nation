{
	quest.4DE6EB265FC317D8.title: "先弄到一张空图纸"
	quest.4DE6EB265FC317D8.description: [
	"整条链的起点。空图纸可以从探索里得到，也能自己造（配方看 JEI）。"
	]
	quest.EA1913D37F5B2396.title: "扫描仪"
	quest.EA1913D37F5B2396.description: [
	"把已经盖好的东西扫进图纸——这是从「手搓」变成「工程制」的第一步。"
	]
	quest.19B8E0B6D47DCAAB.title: "平板"
	quest.19B8E0B6D47DCAAB.description: [
	"图纸的随身载体：走到哪都能看、能选、能放。"
	]
	quest.83D9E4F54239B33C.title: "扫下第一座建筑"
	quest.83D9E4F54239B33C.description: [
	"选一座你们自己盖得最满意的建筑，把它扫成图纸。"
	"⚠️ 「扫成功」这动作没有信号源，自检；判据落在「你已经有了那几样工具」上。"
	]
	quest.4ECB3D418FC7CFC4.title: "全局图纸"
	quest.4ECB3D418FC7CFC4.description: [
	"把常用件做成「全局」的——全队都能取用，不必人手一份。"
	]
	quest.401E6F73A5958036.title: "服务端图纸"
	quest.401E6F73A5958036.description: [
	"放进服务端的那一类：所有人共享同一份，改了就是全队改了。"
	]
	quest.620D533C7B483140.title: "残破图纸要修"
	quest.620D533C7B483140.description: [
	"探索里捡到的图纸多半是残破的：**残破 → 修复 → 可用**，这是设计里明写的一条闭环。"
	]
	quest.60EAF80E4C355C65.title: "图案图纸"
	quest.60EAF80E4C355C65.description: [
	"Create 系的图纸：适合小构件与重复纹样，和便携图纸分工不同。"
	]
	quest.134BCA05AABDAB48.title: "备用图纸"
	quest.134BCA05AABDAB48.description: [
	"多囤几张空白的：现场画比回城取快得多。"
	]
	quest.41366FB6A64C0C4B.title: "材料清单"
	quest.41366FB6A64C0C4B.description: [
	"按图纸算出要多少料，一次性备齐——这是「工程制」和「手搓」最大的区别。"
	]
	quest.219864363A1A025C.title: "按图纸盖出第一座公共建筑"
	quest.219864363A1A025C.description: [
	"不是手搓：照图纸标准件盖，尺寸与用料都由图纸定。"
	"这一条完成之后，「建筑目录」才谈得上（见无尽纪元那一章）。"
	]
	quest.CE3E48ED91035420.title: "第一张图纸是哪来的"
	quest.CE3E48ED91035420.description: [
	"先想清楚这件事：是外购的、扫出来的、还是从废墟里捡的。"
	"来源不同，后面能复制的东西也不同——买来的图纸只能用，扫来的图纸**还能再扫**。"
	"⚠️「图纸到手」这个动作在游戏里没有信号源（该 mod 连 advancement 都没有），所以自检。"
	]
	quest.C9C7B0C141D64E4D.title: "备一批图纸耗材"
	quest.C9C7B0C141D64E4D.description: [
	"图纸是一次性消耗品：现场画、现场放，用完就得回城补。"
	"把常用耗材常备一箱，工程的节奏就不会被「回去拿纸」打断。"
	]
	quest.74E4EEA2DC80A273.title: "修复材料"
	quest.74E4EEA2DC80A273.description: [
	"修复要材料，材料要备。修一张图纸的成本，远低于重新扫一座建筑。"
	]
	quest.C7B0672AC58D4350.title: "现场勘测"
	quest.C7B0672AC58D4350.description: [
	"扫描之前要先**量**：地形高差、朝向、与既有道路的接点。"
	"图纸给的是形状，地图给的是位置——两样都得有。"
	]
	quest.AB5C0F8AB5A21194.title: "选址平面图"
	quest.AB5C0F8AB5A21194.description: [
	"把选址画成一张地图存起来：以后每次讨论「盖在哪」，看的是同一张图。"
	]
	quest.3950266FB1CB2E49.title: "带上笔的图案图纸"
	quest.3950266FB1CB2E49.description: [
	"图纸与笔一体：现场直接画，不必先回城换成套工具。"
	]
	quest.3E615953C275EE6C.title: "蓝图桌"
	quest.3E615953C275EE6C.description: [
	"蓝图桌是图纸的**工作站**：复制、改名、整理都在这张桌子上做。"
	"它一般放在工坊里——图纸和工具放在一起，才不会被当成杂物丢掉。"
	]
	quest.B3C86C23A955D703.title: "算量"
	quest.B3C86C23A955D703.description: [
	"一份清单好不好用，取决于数量算得准不准："
	"少算了，工程停在半路；多算了，材料堆在仓库里占地。"
	]
	quest.761FC57ADC502A54.title: "工程工具箱"
	quest.761FC57ADC502A54.description: [
	"工地和仓库不一样：工具得能一起拎走。"
	"一箱常用件随身，现场缺什么就不用整队停工。"
	]
	quest.73CA9B134387C4C3.title: "脚手架"
	quest.73CA9B134387C4C3.description: [
	"脚手架是「够得着」这件事的答案：高处的活没有它就只能靠搭方块。"
	"安山、黄铜、铜三档，按工地等级挑。"
	]
	quest.B940E9183C1324C4.title: "黄铜脚手架"
	quest.B940E9183C1324C4.description: [
	"为地标级工程配的那一档：能承更多、也更像样。"
	]
	quest.7B9265B1D5A645B0.title: "放线"
	quest.7B9265B1D5A645B0.description: [
	"开工之前先把线放出来：边界、轴线、门洞位置。"
	"这一步做错，后面每一块砖都要返工。"
	]
	quest.0FCB8B8AD3EE9E4C.title: "施工分工"
	quest.0FCB8B8AD3EE9E4C.description: [
	"一座公共建筑不是一个人盖的：谁备料、谁砌墙、谁收尾，事先分好。"
	"分工写下来之后，「有人闲着、有人累死」这件事才有据可查。"
	]
	quest.385F6486AD1DE343.title: "现场检查表"
	quest.385F6486AD1DE343.description: [
	"把「今天该做完什么」列成一张表，收工前逐条对。"
	"这张表是**交接**用的：换班的人看表就知道进度到哪。"
	]
	quest.A9188B3CE369DED8.title: "材料进仓"
	quest.A9188B3CE369DED8.description: [
	"材料不是堆在工地上的：按清单进仓、按清单领料，账才对得上。"
	]
	quest.DEB00227788C9338.title: "收工"
	quest.DEB00227788C9338.description: [
	"工地收工的标准不是「今天干完了」，是**明天能接着干**："
	"脚手架不拆、材料归位、工具入库、现场清干净。"
	]
	quest.6C862CEA82A82912.title: "竣工验收"
	quest.6C862CEA82A82912.description: [
	"对着图纸逐项验收：尺寸、用料、开口位置、周边接驳。"
	"验收通过才登记造册——**没验收的建筑不算资产**。"
	]
	quest.3121A5105DD5FFBD.title: "图纸索引"
	quest.3121A5105DD5FFBD.description: [
	"图纸一多，找图纸就成了成本：书架、讲台、书与笔——给图纸建一套索引。"
	"索引建好之前，每座新城都是「重新找一遍图纸」。"
	]
	quest.15A14E73D26AFAC1.title: "工程记录"
	quest.15A14E73D26AFAC1.description: [
	"书与笔：把这座建筑「谁盖的、用了什么料、改过哪几处」写下来。"
	"记录是给后来的人看的，也是给自己查账用的。"
	]
	quest.4B9034D2E333A872.title: "工地交接"
	quest.4B9034D2E333A872.description: [
	"一座建筑从工程队交给使用方——交接清单要写在牌子上，挂在门口。"
	]
	quest.F81F48CF420CBE28.title: "把建筑变成标准件"
	quest.F81F48CF420CBE28.description: [
	"最后一步不是盖一座楼，而是让**这一套做法**能重复："
	"框架蓝图把构件标准化，图纸进档之后，下一座城照着同一套尺寸盖。"
	"做到这里，「工程制」才算真的成立——你们卖的不再是劳动力，而是标准。"
	]
}
