{
	quest.448E3935771817EF.title: "战斗手感"
	quest.448E3935771817EF.description: [
	"Better Combat：这个包的挥砍有动作与范围——同一把武器，手感完全不同。"
	"它改变的是「怎么打」，所以判据落在最基础的战备上：一把武器 + 一套甲。"
	]
	quest.4608758C21548C11.title: "钢制军械"
	quest.4608758C21548C11.description: [
	"Magistuarmory 的钢制武器系列（钢铸锭 → 各种钢武器）：比铁更耐打，"
	"是组建常备军的前提。"
	]
	quest.F64F34D17AAC647C.title: "长杆与破甲"
	quest.F64F34D17AAC647C.description: [
	"戟、长枪、重锤：对付重甲单位（敌方指挥官就是这一类）必须靠它们。"
	]
	quest.2C49452C48182BA0.title: "弩与齐射"
	quest.2C49452C48182BA0.description: [
	"弩是守城与阵战的主力：整队齐射能压住一波。"
	]
	quest.ECFD190D87FB91B2.title: "投石机"
	quest.ECFD190D87FB91B2.description: [
	"Medieval Siege Machines：这个包里唯一能把「墙」这个概念打破的东西。"
	"它能拆对面的工事——也能让你们第一次意识到自己的墙不够厚。"
	]
	quest.C3A25B018E3751B8.title: "撞门器"
	quest.C3A25B018E3751B8.description: [
	"攻城第一步不是爬墙，是开门——门开了，人才进得去。"
	"它比投石机省事：不用瞄准，推到门口就行。"
	]
	quest.CA9611D678D36354.title: "攻城工坊"
	quest.CA9611D678D36354.description: [
	"器械不是凭空来的：先有攻城工作台，才有后面那一排机器。"
	]
	quest.899FC031DC3F6FF7.title: "攻城营地"
	quest.899FC031DC3F6FF7.description: [
	"器械要有人护、要有料修：营地 = 围栏 + 补给 + 器械停放位。"
	]
	quest.4475184900FF15F4.title: "第一支队伍"
	quest.4475184900FF15F4.description: [
	"Hundred Years Warfare 提供中世纪军事单位（步兵/弓手/骑兵/攻城）。"
	"⚠️ 它**不发进度也不记统计**（实测 advancements=0），所以「招到人」判不了。"
	"验收靠实物：招募与装备军队需要的东西（甲、武器、粮）。"
	]
	quest.9A940306BBCC5E62.title: "军队要吃饭"
	quest.9A940306BBCC5E62.description: [
	"设计里明确写过：军队**必须由国力供养**，不然会变成「暴兵推平一切」，"
	"威胁时代与军工产线都会失去意义。所以这一条是「后勤线」而不是「兵力」。"
	]
	quest.824A56ABFE073F9E.title: "军械库扩容"
	quest.824A56ABFE073F9E.description: [
	"武器、护甲、箭各有专箱，且有下限告警——打仗时没空翻箱。"
	]
	quest.5F1818BF9C4171E0.title: "找到掠夺者营地"
	quest.5F1818BF9C4171E0.description: [
	"It Takes a Pillage：掠夺者营地与堡垒是**主动出击**的目标。"
	"只守不攻，压力只会一直涨。"
	]
	quest.FC064C8563717891.title: "拆掉堡垒"
	quest.FC064C8563717891.description: [
	"打掉发起方，压力才会真正下降一次。"
	]
	quest.4074C3B5291919BA.title: "成建制的军队"
	quest.4074C3B5291919BA.description: [
	"装备、后勤、攻城器械、以及打出去的能力——四样齐了。"
	"到这一步，「夺城」（邦交章最后一条）才真的可执行。"
	]
	quest.830D34A284D2100F.title: "钢制列装"
	quest.830D34A284D2100F.description: [
	"「制式」的意思不是好看，是同型号够一批人用：队列里谁缺什么，一眼看得出来。"
	"这一条按把数、按面数备，不按件数——个人装备章管的是挑一件顺手的。"
	]
	quest.BE7BD4D7B47503F8.title: "盾的四种形制"
	quest.BE7BD4D7B47503F8.description: [
	"鸢盾、圆盾、扇形盾、椭圆盾：遮住的部位不同，走窄道与列阵时的空当也不同。"
	"这里要的是四种都备、按队形发，而不是每人挑一面顺手的。"
	]
	quest.BC82E10B03F261A3.title: "长矛一排"
	quest.BC82E10B03F261A3.description: [
	"矛的价值不在单挑，在并排：一排矛比一排剑多挡住一个身位。"
	"木、铁、钢三档各备一排——木矛练手，钢矛上阵。"
	]
	quest.2798D2514EE9316D.title: "骑枪"
	quest.2798D2514EE9316D.description: [
	"骑枪的长度是给马用的：跑起来那一下才叫冲锋，站住了它比矛难使。"
	]
	quest.417FE343CE4B4839.title: "战马也要披甲"
	quest.417FE343CE4B4839.description: [
	"骑兵冲一次就退回来，原因通常不是人怕，是马先倒。"
	]
	quest.1E871723282E0EB9.title: "靶场加练"
	quest.1E871723282E0EB9.description: [
	"御敌章（编年）定的围城演练是二十次命中；这一条是往上加练到一百次。"
	"练两件事：射准，以及挨打之后还站得住——假人就是用来被打的。"
	]
	quest.ACF7DB2F1662915F.title: "马衣与旗章"
	quest.ACF7DB2F1662915F.description: [
	"两军搅在一起的时候，认错人比挨刀更常见。"
	"队旗这一层归御敌章（编年）；这里管的是马衣图案与马装饰——骑兵的识别靠这些。"
	]
	quest.BC57EE9C9E952FC5.title: "民兵卷轴"
	quest.BC57EE9C9E952FC5.description: [
	"HYW 的部队不是招来的，是**编**出来的：卷轴就是一份编制凭证。"
	"民兵是最低一档——装备差、走得慢，胜在不用练。第一批守夜的人从他们里出。"
	]
	quest.C1622E828B72ABC5.title: "卷轴分阶"
	quest.C1622E828B72ABC5.description: [
	"同一兵种有 I / II / III 阶，差的是装备档次（生成点界面里那一栏就叫 Tier）。"
	"常备军的意义就在这一档：不靠人多，靠用得起好的。"
	]
	quest.AA2FB0458393DF4D.title: "弓手与骑射"
	quest.EFFDDF6FB523C38B.title: "弩手与长矛兵"
	quest.48FE09F73DBDE0F4.title: "盾兵与战士"
	quest.E98507FA42A0220A.title: "骑兵编制"
	quest.E98507FA42A0220A.description: [
	"马、骑枪、骑射手三件凑齐才叫一支骑兵：只有马没有枪的，是交通队。"
	]
	quest.2972CE51B3F3B720.title: "攻城技师"
	quest.2972CE51B3F3B720.description: [
	"器械不会自己上弦：队伍里得有专门摆弄它们的人，不然那些机器只是摆设。"
	]
	quest.FCC13D9C7E7642D0.title: "指挥杖"
	quest.FCC13D9C7E7642D0.description: [
	"指挥杖把喊话变成指令：整队移动、圈选一片区域，按住中键还能调出**阵型**轮盘。"
	"到这一步，队伍才从一堆人变成一个单位。"
	]
	quest.DC003A28291A568B.title: "三种兵齐备"
	quest.DC003A28291A568B.description: [
	"近战、远程、机动各有编制，指挥杖在手——这支部队能列阵，也能分头行动。"
	]
	quest.8AEBA09E852BD696.title: "弩炮"
	quest.8AEBA09E852BD696.description: [
	"直射、架得住：放在墙上打对面的人，也能打对面的器械。"
	]
	quest.6B07AE37F61EAB01.title: "轻型投石机"
	quest.6B07AE37F61EAB01.description: [
	"比巨型投石机好挪，比弩炮打得远——它是跟着队伍走的那一档火力。"
	]
	quest.C72DD0CA611DB45D.title: "攻城塔"
	quest.C72DD0CA611DB45D.description: [
	"它抹平的是「墙」这个优势——自己先造一台，比等别人造一台便宜。"
	]
	quest.43C36445B82F922E.title: "火炮与火药"
	quest.43C36445B82F922E.description: [
	"手推炮往上还有蛇炮、加农炮、巨型火炮，射程与口径都往上走。"
	"它们吃的是火药与弹丸，口径越大越像在吃资源——产线不跟上就打不起。"
	]
	quest.87F94AB0B467D980.title: "补给点"
	quest.87F94AB0B467D980.description: [
	"军队走不远，原因通常不是打不过，是没东西吃。"
	"补给点把「东西从哪来」立成一个点；先有它，才谈往前推多远。"
	]
	quest.C0F5EB0456F64B65.title: "集结点"
	quest.C0F5EB0456F64B65.description: [
	"队伍从哪出来，决定出事时多久能到位。"
	]
	quest.D4656D29C3A95900.title: "军需仓库"
	quest.D4656D29C3A95900.description: [
	"仓库控制块 + 存储块：军械与粮草分开记账，领料不必再问人。"
	]
	quest.C9457DB83B779D11.title: "运输指令"
	quest.C9457DB83B779D11.description: [
	"补给线真正的瓶颈是运力：路线太长，东西就一直在路上。"
	]
	quest.21FB29B28C55F68B.title: "随军工作站"
	quest.21FB29B28C55F68B.description: [
	"农、矿、伐木、渔、牧、合成六种工作站，把「养兵」摊进日常生产里。"
	"它们同时也是平民的活计——军民两用，才不会养出一群只会吃的人。"
	]
	quest.A32E9AFC4B6417A0.title: "运输工与合成工"
	quest.64D75C3D6D275CC5.title: "后勤成链"
	quest.64D75C3D6D275CC5.description: [
	"补给点、集结点、军需仓库、运输指令、工作站各就各位——打得远不远，由这条线决定。"
	]
	quest.18B5A075ECD84AD4.title: "反制云梯"
	quest.18B5A075ECD84AD4.description: [
	"守方视角：云梯靠上墙就变成一条单人通道——堵住顶端，比拆整架梯子省力。"
	"先在自己墙上架一次，比看图纸有用。"
	]
	quest.D11D7DB18B72F874.title: "反制撞门锤"
	quest.D11D7DB18B72F874.description: [
	"撞门锤只认得门那一格；门后面是什么，是守方决定的。"
	"留一台在自己的门外演一次，就知道哪一段门最经不起推。"
	]
	quest.619EDA35F7242356.title: "反制预案"
	quest.619EDA35F7242356.description: [
	"来犯方式就那么几种：爬墙、撞门、围着不走。预案的意义是先想好，而不是当场想。"
	]
	quest.B3F4756BDF1D2C7A.title: "出城反击"
	quest.B3F4756BDF1D2C7A.description: [
	"只守不攻，对方就能从容架梯子上墙；出城打一次，节奏才在自己手里。"
	]
	quest.A7C1EEF9C8793454.title: "缴获入账"
	quest.A7C1EEF9C8793454.description: [
	"抢来的东西归公还是归己，是「国家行为」与「土匪」的分界——先把缴获集中起来。"
	"灾厄旗帜那一瓶是队长的凭证，挂上墙就是这一仗的物证。"
	]
}
