{
	quest.CCB0AFD4DE255272.title: "一把厨刀"
	quest.CCB0AFD4DE255272.description: [
	"农夫乐事的第一步。有了刀，割草得稻草、切菜下锅——整条食物线的起点。"
	]
	quest.03FB683BE6B54C4F.title: "砧板"
	quest.03FB683BE6B54C4F.description: [
	"锅里能放什么，先由砧板决定：切菜、剁肉、剔骨都在这里做完。"
	"它是烹饪的前置——没有它，很多菜谱根本进不了锅。"
	]
	quest.F4173A922D4F7741.title: "下锅"
	quest.F4173A922D4F7741.description: [
	"烹饪锅：能一次做出一锅给全队吃的菜。食堂的核心设备。"
	]
	quest.9C29EE9C2A49ECD9.title: "灶台与平底锅"
	quest.9C29EE9C2A49ECD9.description: [
	"从「炖」升级到「煎」——同一份食材能做出不同的菜。"
	]
	quest.852B4FC0F6322FDE.title: "沃土"
	quest.852B4FC0F6322FDE.description: [
	"有机肥 + 沃土：不换地也能持续产出，这是农场长期化的关键。"
	]
	quest.5D0B448782CB1030.title: "吃顿像样的"
	quest.5D0B448782CB1030.description: [
	"营养餐：这个包的食物系统有「营养」概念，吃饱与吃好是两件事。"
	]
	quest.B37CDD8AA8722C5E.title: "把作物种全"
	quest.B37CDD8AA8722C5E.description: [
	"农夫乐事的作物全种一遍。这条是「农场」与「菜园」的分界线。"
	]
	quest.C82A23CBBEEC848F.title: "鸡舍"
	quest.C82A23CBBEEC848F.description: [
	"Farm & Charm 的畜舍系列：畜牧从「围一圈」升级到「有设施」。"
	]
	quest.2AC3A4AEF445D9A8.title: "奶与黄油"
	quest.2AC3A4AEF445D9A8.description: [
	"奶制品线：黄油是很多菜的前置。"
	]
	quest.FE741E7B9F5D8875.title: "发酵桶"
	quest.FE741E7B9F5D8875.description: [
	"Vinery 的酿酒线：果汁 → 发酵 → 酒。这是这个包里少见的「慢工艺」。"
	]
	quest.BB844AAB017F1E65.title: "酒架"
	quest.BB844AAB017F1E65.description: [
	"酒酿好之后要有个地方陈着，不然只能堆在箱子里占位置。"
	"架子本身也是陈设——食堂里摆一排，比一排箱子像样。"
	]
	quest.59FFC9FBC635C1DC.title: "种下第一株葡萄"
	quest.59FFC9FBC635C1DC.description: [
	"Vinery 有自己的进度（实测 20 条），种葡萄那条就在里面。"
	]
	quest.F358D05FDF4875D0.title: "榨汁"
	quest.F358D05FDF4875D0.description: [
	"果汁是酒的中间产物，也是一类能喝的补给。"
	]
	quest.3DADC237242CA928.title: "食物专用储藏"
	quest.3DADC237242CA928.description: [
	"Storage Delight 的橱柜/抽屉：食物要按类放，不然会烂在背包里。"
	]
	quest.B1A457053074F6D9.title: "厨房一体化"
	quest.B1A457053074F6D9.description: [
	"Cooking for Blockheads：把厨房设备连成一张操作面，不用来回跑。"
	]
	quest.31744FC4433AEAA5.title: "市场与种子"
	quest.31744FC4433AEAA5.description: [
	"Farming for Blockheads 的市场：买种子、买树苗，省掉满地图找野生的时间。"
	]
	quest.874E2D2B690469E6.title: "办一桌席"
	quest.874E2D2B690469E6.description: [
	"把这一章的东西凑成一桌：主菜、配菜、饮品、甜点各有一样。"
	"这一条之后，「食堂」才算真的开张（基建章的食堂到了这里才有内容）。"
	]
	quest.3349B259353ACB31.title: "草秆"
	quest.EC2FA26DBF6A5613.title: "整块肉"
	quest.6FF9C7201D4FE499.title: "在家种蘑菇"
	quest.4CCA50D7CB6CF083.title: "有机堆肥"
	quest.05DE0BEEB15AE537.title: "浅水里的稻"
	quest.CC6C9ACB8852B43F.title: "把菜端上桌"
	quest.CC6C9ACB8852B43F.description: [
	"一个人吃饭，碗就够；宴席块是给一屋子人准备的。"
	"食堂、宴请、节庆都要用到它，所以放在本章中段。"
	]
	quest.444FDF195136ED40.title: "农庄的锅灶"
	quest.444FDF195136ED40.description: [
	"Farm & Charm 的烹饪线：同一批食材，菜谱比乐事更偏农家菜。"
	"它和厨锅共用原料，所以排在乐事的锅之后。"
	]
	quest.AD0C57B4F49E11D4.title: "烘焙机"
	quest.7CECBADDA0B9934C.title: "绞肉机"
	quest.1AD8D6AE1942F941.title: "肥沃泥土"
	quest.4F95F99A3916D6EB.title: "洒水器"
	quest.AB0BF6A73DF6D191.title: "烤箱"
	quest.E4C2B7D818851FBD.title: "冰箱"
	quest.99A9EDF7E5416C56.title: "保鲜室"
	quest.79AAD64EE9125ABE.title: "苹果压榨器"
	quest.79AAD64EE9125ABE.description: [
	"Vinery 的第一步不是葡萄，是压榨：果汁与果泥都从这里出。"
	"先有压榨，后面的发酵与陈酿才有原料。"
	]
	quest.6438450F8DB65E22.title: "第一颗樱桃"
	quest.3F749E094ABBD534.title: "让藤蔓爬上去"
	quest.4FC9806DF3A1E7A2.title: "第一瓶酒"
	quest.98A01A265BCC9DAA.title: "把酒单集全"
	quest.98A01A265BCC9DAA.description: [
	"Vinery 的终点不是一瓶酒，而是一整柜。"
	"酒款集齐之后，酒窖与宴会才算真正开张。"
	]
	quest.1D2D16DF8FF038DA.title: "发酵桶（酿造与咀嚼）"
	quest.105B587364AFF5BC.title: "给桶控温"
	quest.6DEF2AD8CA1E4F45.title: "奶酪"
	quest.FDCB89A2D74156CD.title: "扩展乐事：榨汁机"
	quest.FDCB89A2D74156CD.description: [
	"Expanded Delight 把厨房往外接了一段：榨汁、罐头、盐与奶酪。"
	"前面的厨具到这里才算有了产线。"
	]
	quest.5DAD08228930245B.title: "盐"
	quest.6C226AD3AAD1CC17.title: "花生酱"
	quest.9CE7D3C148C5E154.title: "潜影贝上桌"
	quest.9CE7D3C148C5E154.description: [
	"末地的东西本来只能换经验；Ender's Delight 让潜影贝与虚空胡椒进厨房。"
	"所以这一条排在去过末地之后。"
	]
	quest.BC253B9B9A7F3536.title: "虚空胡椒"
	quest.10AF811BED8B99DC.title: "下界炉灶"
	quest.0DD0A7B2F1868C48.title: "填馅疣猪兽"
	quest.696FEEEBE30AED1F.title: "守卫者浓汤"
	quest.2F604EC3FF4722ED.title: "洞里的铜锅"
	quest.29110956A5F7695A.title: "洞穴萝卜"
	quest.822124A587CAC57E.title: "杯装汤"
	quest.15F094975BE3C08C.title: "村里的厨师"
	quest.15F094975BE3C08C.description: [
	"Chef's Delight 往村庄里添了厨师与厨工两户人家，房子只在村庄里生成。"
	"懒得自己种的时候，这是最省事的一条补给线。"
	]
}
