{
	quest.A5DB0F3C70C45AE0.title: "路通四邻"
	quest.A5DB0F3C70C45AE0.description: [
	"主路从城里铺出去 500 格以上，连到最近的水源、林地或别人家。"
	]
	quest.FB8262D01AF48E73.title: "第一件事不用人管"
	quest.FB8262D01AF48E73.description: [
	"选一件事（原木、圆石、食物、熔炼任选），做成「原料进、成品出、中间没有人」。"
	"Create 会给你一个进度——它就是这条的判据。"
	]
	quest.012C33D8C552CEF0.title: "三件事不用人管"
	quest.012C33D8C552CEF0.description: [
	"一条线不算自动化，三条才算「基建成型」。"
	"到这一步，你们的时间才真正开始用在建造上，而不是搬东西。"
	]
	quest.C268D78E02E9E408.title: "通电"
	quest.C268D78E02E9E408.description: [
	"应力网络跑起来：动力从源头送到每台机器，别让某一段卡住整条线。"
	]
	quest.7C06E9343F0EADB2.title: "工坊分区"
	quest.7C06E9343F0EADB2.description: [
	"锻造、木工、缝纫各占一格，各有各的工作台——不要再一间屋子干所有事。"
	]
	quest.E3C7DEDEE8D14CCE.title: "食堂开张"
	quest.E3C7DEDEE8D14CCE.description: [
	"能一次喂饱全队：≥4 种食物同时摆出来。"
	"这一条解决的是「各自吃各自的」——聚在一起吃饭是分工的开始。"
	]
	quest.2B64267939E85BB3.title: "地图墙覆盖核心区"
	quest.2B64267939E85BB3.description: [
	"≥4 张地图拼起来，把国土与周边连成一张图。"
	"⚠️ 「覆盖完整」是主观的（有没有空洞得自己看），所以这一条自检。"
	]
	quest.C6B025CC62D08367.title: "采矿机"
	quest.C6B025CC62D08367.description: [
	"让它自己往下挖并把矿运回来——这是「不必人到场」的第一条矿线。"
	"注：Create 的进度里没有「机械钻」这一条（实测），所以判据落在**粉碎轮**上"
	"（钻头与粉碎轮是同一条产线的前后两段）。"
	]
	quest.EA86031E9BE1465E.title: "熔炉阵列"
	quest.EA86031E9BE1465E.description: [
	"≥8 台并联，一次投料连续工作。"
	]
	quest.ACD94784ED1B0EA7.title: "农场自动化"
	quest.ACD94784ED1B0EA7.description: [
	"收割与补种自动，或者畜栏自动收集——总之不用人天天去收。"
	]
	quest.43BD1559C781622B.title: "物品电梯"
	quest.43BD1559C781622B.description: [
	"把矿底的东西送到地面，别再用背包一层层搬。"
	]
	quest.306CE9560F0230E8.title: "列车或传送"
	quest.306CE9560F0230E8.description: [
	"两地之间点对点运输，≥300 格。设计里「交通等级扩大远征半径」从这一步开始。"
	]
	quest.50906F1B2968CD26.title: "批量分拣"
	quest.50906F1B2968CD26.description: [
	"≥4 种物品各进各的仓。用漏斗或机械臂都行，关键是**不用手摆**。"
	]
	quest.47B8A9D20F062068.title: "产线不卡壳"
	quest.47B8A9D20F062068.description: [
	"某一条线满了或断了，不该把别的线一起拖死。"
	]
	quest.C7BA24CC200F2831.title: "下矿到底"
	quest.C7BA24CC200F2831.description: [
	"到达深板岩层，带回至少 3 种矿物。"
	]
	quest.7D783459FC833D03.title: "第二处兴趣点"
	quest.7D783459FC833D03.description: [
	"1000 格外找一处值得再去的地方（结构、矿脉、异景），并让路能通到它。"
	]
	quest.EEFBAE645686C7F5.title: "第一道围墙"
	quest.EEFBAE645686C7F5.description: [
	"合围主城，门是可控的（能关得上）。"
	]
	quest.42B7E62C0AFD4C62.title: "情报站"
	quest.42B7E62C0AFD4C62.description: [
	"这个时代解锁了情报站（`eras.json` 的 unlocks 里有 `intel_station`）。"
	"详细走法见「邦交」章——这里只提示它在这一时代解锁。"
	]
	quest.7B66D80B4C4016F5.title: "基建碑"
	quest.7B66D80B4C4016F5.description: [
	"刻上这个时代最大的那项工程。"
	"下一时代要往外走了：把路、车、补给点先准备好。"
	]
	quest.11875898F0862C88.title: "水塔"
	quest.11875898F0862C88.description: [
	"主城要有稳定的取水点，不能靠人一桶桶拎。"
	"泵 + 储罐 + 管道，把水从水源送到用水处——这是后面所有流体产线的样板。"
	]
	quest.3AB5B8E562CEDFC4.title: "灌溉渠"
	quest.3AB5B8E562CEDFC4.description: [
	"田地要能自己浇上水。耕地离水源远的时候，这一条决定农场能不能扩。"
	]
	quest.4E1FABCBDD04417E.title: "排水"
	quest.4E1FABCBDD04417E.description: [
	"积水会淹掉矿道与地下室。排水做一遍，比每次被淹了再救省事。"
	]
	quest.93622208681F9DFD.title: "路灯成网"
	quest.93622208681F9DFD.description: [
	"主路与街巷夜里不刷怪，靠的是连续照明而不是零散几盏。"
	"这个时代最常见的损失是「回家路上被摸黑打一顿」——路灯直接解决它。"
	]
	quest.9BA0FFB7F76C982C.title: "矿道照明"
	quest.9BA0FFB7F76C982C.description: [
	"矿道黑一处就等于埋一个雷。照明铺满，掉落与迷路都会少。"
	]
	quest.E253DFB73190A6FF.title: "防火隔离"
	quest.E253DFB73190A6FF.description: [
	"木构区之间留出石质隔断。这是全包唯一防「一把火烧掉半个城」的手段。"
	]
	quest.5F9B091390C9CE12.title: "圈栏与门"
	quest.5F9B091390C9CE12.description: [
	"牲畜与农作物要拦住，城门要能控。围栏是城市与野地的实际边界。"
	]
	quest.F9E3450496E7962A.title: "瞭望位"
	quest.F9E3450496E7962A.description: [
	"视野高于城墙才看得远。发现得早，比打得好更重要。"
	]
	quest.C8A37DC682115636.title: "宿舍"
	quest.C8A37DC682115636.description: [
	"每人都有一张自己的床（而不是挤在一起）。重生点分散，才不会一锅端。"
	]
	quest.AD0C9002D7C1607F.title: "广场"
	quest.AD0C9002D7C1607F.description: [
	"集合点要有明确的中心。以后发号施令、分派任务都从这里开始。"
	]
	quest.5BFC98166D00E41F.title: "分区仓库"
	quest.5BFC98166D00E41F.description: [
	"每个工坊旁边一个小仓，不要所有东西都往总仓跑。"
	"这一步省的是「来回走路」，它比任何自动化都先见效。"
	]
	quest.1681123594D42BFD.title: "修理台"
	quest.1681123594D42BFD.description: [
	"工具要有地方修。附魔与耐久管理的落脚点在这里。"
	]
	quest.993F5DBB86D7FD03.title: "桥"
	quest.993F5DBB86D7FD03.description: [
	"路遇到水就断了。桥是把路网连成网的关键一件。"
	]
	quest.49ACCAF3D5A94B07.title: "隧道"
	quest.49ACCAF3D5A94B07.description: [
	"穿山比绕山省时间。隧道打通一次，之后每次都省。"
	]
	quest.DCC982E7823FBB5F.title: "区域路牌"
	quest.DCC982E7823FBB5F.description: [
	"每个岔口有牌子指向目的地。多人一起玩时，这一条省的是所有人的问路时间。"
	]
	quest.36F190164EE15610.title: "补给点"
	quest.36F190164EE15610.description: [
	"远路上要有补给：食物、工具、备用装备。"
	"有补给点，远征半径才真的能扩大。"
	]
	quest.8426F12D15F228D6.title: "邮包分拣"
	quest.8426F12D15F228D6.description: [
	"远距离点对点送东西，不用人跑。"
	"配合铁路/传送，这是「人不动、货能动」的开始。"
	]
	quest.B62EEA3E007AEE91.title: "大宗储备"
	quest.B62EEA3E007AEE91.description: [
	"常用建材要有安全库存，不要每次现凑。"
	"多人建造最怕「材料不够、全员停工」——储备就是解决它。"
	]
	quest.6CD7F5AB7DF4943E.title: "工位与工具墙"
	quest.6CD7F5AB7DF4943E.description: [
	"每个工坊有自己的工具位与备用工具。找工具的时间也是成本。"
	]
	quest.882CA8C303153C95.title: "燃料储备"
	quest.882CA8C303153C95.description: [
	"熔炉、蒸汽机、列车都吃燃料。储备见底时整座城会一起停摆。"
	]
	quest.69CFAD8435DF0EAA.title: "粮食储备"
	quest.69CFAD8435DF0EAA.description: [
	"闹饥荒的代价远大于囤粮占的地方。这一条是「能撑过意外」的底线。"
	]
	quest.89BFDFADBBB1C93C.title: "水坝"
	quest.89BFDFADBBB1C93C.description: [
	"先选一处河湾拦起来，把水位抬成可用的落差。"
	"落差是后面所有流体设施省力的地方——泵要抽得省，靠的就是它。"
	]
	quest.D61BAC24BB1ED9C7.title: "水库"
	quest.D61BAC24BB1ED9C7.description: [
	"坝拦下来的水要有地方存。存量决定旱季与围攻期间能撑多久。"
	]
	quest.796FC1F0C891D555.title: "渡槽"
	quest.796FC1F0C891D555.description: [
	"跨过山谷与道路把水送到用水处，不必让渠绕一大圈。"
	"它是水利里最像工程的一件：看得见，也要求一次把坡度做对。"
	]
	quest.27A483C0D44B2B73.title: "井群"
	quest.27A483C0D44B2B73.description: [
	"在城里均匀打几口井，让每个片区都能就近取水。"
	"井群是供水网的兜底：主管断了，城不至于立刻断水。"
	]
	quest.594C07F89DAD8B3D.title: "主干道"
	quest.594C07F89DAD8B3D.description: [
	"城市与外界的路要有一条等级最高的：宽、直、不积水，而且能走车。"
	"支路可以窄，主干道不行——运力都压在它身上。"
	]
	quest.876F02B8D3A62CBC.title: "支路与人行道"
	quest.876F02B8D3A62CBC.description: [
	"铺装分两级：走货的与走人的。人行道铺出来，城市才不是一片工地。"
	]
	quest.183615AF75831AA9.title: "台阶与坡道"
	quest.183615AF75831AA9.description: [
	"高差要能走。每处高台都该接上台阶或坡道，而不是靠人往上跳。"
	]
	quest.CD3166E69AE76182.title: "石桥"
	quest.CD3166E69AE76182.description: [
	"常走的过河点要用石桥：耐久、能过车，也不会像木桥那样烧起来。"
	]
	quest.7398CF6A4D6139EA.title: "吊桥"
	quest.7398CF6A4D6139EA.description: [
	"深谷与峭壁之间立不住桥墩，索桥是唯一划算的做法。"
	"它接的是那些「绕过去要半小时」的地方。"
	]
	quest.400656B38C4A98C7.title: "跨谷桥"
	quest.400656B38C4A98C7.description: [
	"跨度到这一档，桥本身就是一处地标：一次建成，之后长期都靠它。"
	]
	quest.DB61CBE0B98ACCD9.title: "明渠"
	quest.DB61CBE0B98ACCD9.description: [
	"排水沟敞开走，好处是堵了看得见、能掏。先把这一层铺满主路两侧。"
	]
	quest.734FF60ED7964483.title: "暗管"
	quest.734FF60ED7964483.description: [
	"穿过道路与建筑的那一段必须走地下，否则一条沟把城市切成两半。"
	"明渠与暗管接得上，排水才算一套系统。"
	]
	quest.F74623B6DB682AAD.title: "蓄洪池"
	quest.F74623B6DB682AAD.description: [
	"暴雨时先存后放，比把水一次性推给下游便宜得多。池底要能事后清干净。"
	]
	quest.B1E6EC11CDB063D1.title: "单向道与环岛"
	quest.B1E6EC11CDB063D1.description: [
	"城里的路一多，会车就成了主要堵点。"
	"环岛与单向道把路口从冲突点改成通过点，不需要任何机器。"
	]
	quest.C92692DC1C4DFE00.title: "停车区"
	quest.C92692DC1C4DFE00.description: [
	"矿车、船只与载具要有固定停放处。随手停在路口，堵的是自己人。"
	]
	quest.B51559625DCEDE80.title: "中转驿站"
	quest.B51559625DCEDE80.description: [
	"远路上人要歇、货要换装。驿站是两种运输方式的接缝。"
	"有了它，长途可以分段接力，不必一次走完全程。"
	]
	quest.FF1434D794A02CF8.title: "配电干线"
	quest.FF1434D794A02CF8.description: [
	"动力不能一台机器拉一条线：先定一个源，再沿路送到每个片区。"
	"这一层做好了，以后每添一台机器都不用重新拉线。"
	]
	quest.5F4231D285BC1FBF.title: "变电所"
	quest.5F4231D285BC1FBF.description: [
	"电压要在城里再分一级，否则一次故障会带走整片城区。"
	]
	quest.8B6544DE73A989A2.title: "计量与开关"
	quest.8B6544DE73A989A2.description: [
	"哪一段在耗、哪一段该断，要能当场看出来。"
	"计量到位之后，排查从「全线摸一遍」变成「看表」。"
	]
	quest.1F3E380C7DBD5448.title: "市政干管"
	quest.1F3E380C7DBD5448.description: [
	"水、料、缆走同一条沟，是城市与村落的分界：开挖一次，全部到位。"
	]
	quest.7A7596A8000D9F39.title: "分区接入验收"
	quest.7A7596A8000D9F39.description: [
	"住、工、农、仓四个片区各有一处接入点，而且都能单独关断。"
	"这一条验收的是覆盖而不是长度：漏掉一个片区，它就会变成孤岛。"
	]
	quest.A9F054E8EAD23735.title: "消防水池"
	quest.A9F054E8EAD23735.description: [
	"木构城市最贵的教训是火。水池与取水点常备，比事后重建便宜。"
	]
	quest.EEF4438ADC31FA16.title: "疏散通道与备用出口"
	quest.EEF4438ADC31FA16.description: [
	"每个片区至少两条出路，而且互不重叠。"
	"被围一次就会明白：只有一个门的城，等于没有门。"
	]
	quest.AA85F1179C7CB43D.title: "护城河"
	quest.AA85F1179C7CB43D.description: [
	"水是比墙便宜的屏障，而且可以接进排水系统当末端蓄水。"
	]
	quest.63690B16A709DD40.title: "关卡与门禁"
	quest.63690B16A709DD40.description: [
	"城门要能控：能关、能查、能只放自己人。"
	"边界不是画出来的，是有人管着的那几个口子。"
	]
	quest.2391DC691E88B107.title: "测量与放线"
	quest.2391DC691E88B107.description: [
	"开工前先定基准点与标高，后面所有尺寸都从这里算。"
	"没有放线的工地，做出来的东西对不上，改起来比重做贵。"
	]
	quest.028A0E52862EA4D0.title: "脚手架"
	quest.028A0E52862EA4D0.description: [
	"高处作业要有地方站。它决定同一件事是一个人做还是三个人做。"
	]
	quest.BC53040EBB17FE61.title: "临时工棚"
	quest.BC53040EBB17FE61.description: [
	"工地旁边要有休息与存放的地方。省下的是往返主城的那段路。"
	]
	quest.5BCAC8BE5536FA2E.title: "材料堆放场"
	quest.5BCAC8BE5536FA2E.description: [
	"工地要有一处按规格分堆的料场，而不是把所有东西倒在一处。"
	"料场整齐，取料时间就短——这是施工里最容易省下的一段时间。"
	]
	quest.235ADF1F08F06F66.title: "市政工程验收"
	quest.235ADF1F08F06F66.description: [
	"水、电、路、桥、排水、应急各成一套，而且都接到了每个片区。"
	"这一章前面那些散件，到这一步才合成一座城。"
	]
}
