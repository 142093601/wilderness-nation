{
	quest.C946CDB9DF287ECE.title: "先把「看」的工具备齐"
	quest.C946CDB9DF287ECE.description: [
	"这个包里有一整套**客户端界面 mod**，它们不占物品栏、也不会出现在 JEI 里："
	"· Xaero's 世界地图 / 小地图：自动生效，按快捷键打开"
	"· Jade：指着方块就显示它是什么"
	"· Traveler's Titles：进新群系/维度时屏幕上出现区域名"
	"· Explorer's / Nature's Compass：手里拿着才起作用（这两样是**真物品**）"
	"⚠️ 界面类工具没有物品判据（实测：这些 mod 的 item 键数为 0），所以这一条自检。"
	]
	quest.9004448B5DC4C470.title: "结构罗盘"
	quest.9004448B5DC4C470.description: [
	"Explorer's Compass：指到最近的结构。远征找目标不再靠运气。"
	]
	quest.5361C6541C525E23.title: "生物群系罗盘"
	quest.5361C6541C525E23.description: [
	"Nature's Compass：找群系。想找某种木材或地形时它最省时间。"
	]
	quest.00B3D4C1CE27A7E2.title: "走遍主要群系"
	quest.00B3D4C1CE27A7E2.description: [
	"原版进度「探索时间」要求走遍几乎所有群系——在这一包里它自然就完成了，"
	"但它是「你确实到处走过」最可靠的证据。"
	]
	quest.337CEEB0C3C2B1F0.title: "走了一百万格"
	quest.337CEEB0C3C2B1F0.description: [
	"一万格 ≈ 10 公里。走到这个数，你们的地图才算「有内容」。"
	]
	quest.C5B031F2B289B39A.title: "试炼厅"
	quest.C5B031F2B289B39A.description: [
	"1.21 的新结构：试炼厅与重核。原版进度能判。"
	]
	quest.B93891C782DB72E9.title: "深暗之域"
	quest.B93891C782DB72E9.description: [
	"潜行到远古城市——最危险也最值钱的一类探索（沉默与幽匿）。"
	]
	quest.CF3AEFF02D9CA5D5.title: "刷怪笼与地牢"
	quest.CF3AEFF02D9CA5D5.description: [
	"改造一个刷怪笼：把危险变成资源。这是很多自动化线的起点。"
	]
	quest.44CF0609ECFC72DE.title: "在草原上放一次音乐"
	quest.44CF0609ECFC72DE.description: [
	"看起来没用，但它是这个包「文明」气质的一部分——原版进度会给它盖章。"
	]
	quest.7B74DD1DBB45EAB2.title: "走遍下界"
	quest.7B74DD1DBB45EAB2.description: [
	"下界有五种群系，走遍它是「下界不再是采矿区」的标志。"
	]
	quest.38A9B962976509A1.title: "要塞与堡垒"
	quest.38A9B962976509A1.description: [
	"下界要塞（烈焰棒）与堡垒遗迹（猪灵）——两条独立的下界线。"
	]
	quest.BBD3E994F92EE44C.title: "远古残骸"
	quest.BBD3E994F92EE44C.description: [
	"下界合金的唯一来源。挖到它意味着你们的装备可以进下一档。"
	]
	quest.4ECFA357D8694C57.title: "末地城"
	quest.4ECFA357D8694C57.description: [
	"鞘翅与潜影盒都在这里。到这一步，你们的活动范围从「地面」变成「任意地方」。"
	]
	quest.7C2154777BD98881.title: "地图连成一片"
	quest.7C2154777BD98881.description: [
	"主城周边 + 两条远征路线 + 下界通道，都画进同一张地图。"
	"到这一步，「情报墙」才有东西可挂（见出关章）。"
	]
	quest.47905F6278DE99C1.title: "纸质地图"
	quest.47905F6278DE99C1.description: [
	"界面上的地图只有自己看得见；纸质地图能挂在墙上、能复制发给队友。"
	"情报墙、行军图、前哨交接都靠它，所以它是这一簇里第一件要囤的东西。"
	]
	quest.A42C2692B077EDA0.title: "制图台"
	quest.1F09BC64D2F56A6B.title: "路标与旗标"
	quest.4B270579EF8D2E33.title: "磁石指路"
	quest.4B270579EF8D2E33.description: [
	"磁石把指南针钉在一个固定点上，于是「家」有了一个不随坐标漂移的方向。"
	"它和地图是两件事：地图告诉你周围有什么，磁石告诉你该往哪走。"
	]
	quest.CCE96AF37541A9B0.title: "修复结构罗盘"
	quest.01C6AEA73775BEF8.title: "修复自然罗盘"
	quest.A5F90DE89218B99E.title: "玩家追踪罗盘"
	quest.A5F90DE89218B99E.description: [
	"指人而不是指地方：多人分头行动时，走散与集合都不必再靠喊坐标。"
	"它把「队友在哪」也变成一件可以查的事。"
	]
	quest.1C5DCB2025657547.title: "石碑：网络的起点"
	quest.1C5DCB2025657547.description: [
	"传送石碑是把「距离」换成「有没有连上」的那个方块。"
	"四座是起步：主城、驿站、矿场、前线各一处，网络才谈得上覆盖。"
	]
	quest.B6C4BEB1EA36EBB3.title: "苔石与砂岩石碑"
	quest.0009B4C46DB56B0B.title: "深板岩与海晶石碑"
	quest.92FE5B29D2FACD9D.title: "黑石与地狱砖石碑"
	quest.CCC0362703EF2DD5.title: "末地石与紫珀石碑"
	quest.906BF6E86844F622.title: "碎片两态"
	quest.B3C1AA2AC229D1F5.title: "传送粉"
	quest.E4721B5614E07B08.title: "传送石"
	quest.064A0DB4D68AE036.title: "传送门方块"
	quest.833859484152F679.title: "空白卷轴"
	quest.4CE83764D5382761.title: "返回卷轴"
	quest.2503EC0E2301191D.title: "已绑定的传送卷轴"
	quest.23ECB027C05089EB.title: "瞬忆碑"
	quest.23ECB027C05089EB.description: [
	"卷轴这条线收在这里：出门带什么、怎么回来，都有了一件固定的事对应。"
	]
	quest.B95FC1D30DE004EA.title: "灰阶石座"
	quest.C1FA9A00DFA1B9D8.title: "暖色石座"
	quest.09AED4E9A63CD5AF.title: "青绿石座"
	quest.71A98AEBC96FC797.title: "蓝紫石座"
	quest.818269FFE0D88C0A.title: "灰阶共享石碑"
	quest.4A16B009DC643ED9.title: "暖色共享石碑"
	quest.C5D634F88470A048.title: "青绿共享石碑"
	quest.B1ABC7E7CCC0498B.title: "蓝紫共享石碑"
	quest.BB80B16703B4B3D9.title: "石座与共享石碑配齐"
	quest.BB80B16703B4B3D9.description: [
	"十六色石座与十五色共享石碑（白色那面就是基座方块本身）各就各位——"
	"颜色在这里不是装饰，是给不同路线、不同队伍分档用的标记。"
	"到这一步，传送网络从「几座石碑」变成一套有编号的设施。"
	]
}
